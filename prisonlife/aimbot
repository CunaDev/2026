local function HideUI()
    if ui.fovCircle then ui.fovCircle.Visible = false end
    if ui.fov then ui.fov.Visible = false end
    if ui.marker then ui.marker.Visible = false end
    if ui.label then ui.label.Visible = false end
    if ui.tracer then ui.tracer.Visible = false end
    if ui.debug then ui.debug.Visible = false end
    if ui.status then
        ui.status.Text = "AIMBOT  |  OFF"
    end
end

local function UpdateUI(candidate, radius)
    local camera = GetCamera()
    if not camera or not ui.gui then
        return
    end

    local settings = GetSettings()
    local mousePosition = GetMousePosition()
    local diameter = radius * 2
    local fovColor = GetFovColor()
    local tracerEnabled = GetFlag("aimbot_tracer") == true
    local debugEnabled = GetFlag("aimbot_debug") == true
    local toggleBind = GetToggleKeyBind()
    local toggleState = toggleBind and toggleBind.active == true

    -- FOV circle (centered on the mouse cursor)
    if ui.fovCircle then
        ui.fovCircle.Position = mousePosition
        ui.fovCircle.Radius = math.max(radius, 1)
        ui.fovCircle.Color = fovColor
        ui.fovCircle.Visible = IsAimbotEnabled() and settings.fovDraw
    elseif ui.fov then
        ui.fov.Position = UDim2.fromOffset(mousePosition.X - radius, mousePosition.Y - radius)
        ui.fov.Size = UDim2.fromOffset(diameter, diameter)
        ui.fov.Visible = IsAimbotEnabled() and settings.fovDraw
        ui.fov.BorderColor3 = fovColor
    end

    if not candidate then
        ui.marker.Visible = false
        ui.label.Visible = false
        if ui.tracer then ui.tracer.Visible = false end
        ui.status.Text = "AIMBOT  |  NO CANDIDATE"
        if debugEnabled and ui.debug then
            ui.debug.Visible = true
            ui.debugText.Text = string.format(
                "FPS: %d\nMode: %s\nSpeed: %.2f\nToggle: %s\nMouseUI: %s\nCandidates: 0",
                ui.fps,
                settings.aimMode,
                settings.aimSpeed,
                toggleState and "ON" or "OFF",
                IsMouseOverGui() and "YES" or "no"
            )
        elseif ui.debug then
            ui.debug.Visible = false
        end
        return
    end

    local point = candidate.screenPoint
    local healthColor = GetHealthColor(candidate.humanoid.Health, candidate.humanoid.MaxHealth)

    -- Target marker with health-based color
    ui.marker.Position = UDim2.fromOffset(point.X, point.Y)
    ui.marker.BackgroundColor3 = healthColor
    ui.marker.Visible = true

    -- Info label
    local aimMode = settings.aimMode
    local keyState = ""
    if settings.keyMode == "Toggle" then
        keyState = aimKeyToggled and " [ON]" or " [OFF]"
    else
        keyState = IsAimKeyPressed(settings) and " [HOLD]" or " [--]"
    end

    ui.label.Position = UDim2.fromOffset(point.X, point.Y + 12)
    ui.label.Text = string.format(
        "[%s] %s | %s | %.0f studs | HP %.0f/%.0f | %s%s",
        aimMode,
        candidate.player.DisplayName,
        candidate.player.Team and candidate.player.Team.Name or "NoTeam",
        candidate.distance,
        candidate.humanoid.Health,
        candidate.humanoid.MaxHealth,
        tostring(GetFlag("aimbot_target_priority")),
        keyState
    )
    ui.label.Visible = true

    -- Tracer from crosshair to target (only when tracer flag is enabled)
    if ui.tracer then
        if tracerEnabled then
            local viewport = camera.ViewportSize
            local center = Vector2.new(viewport.X * 0.5, viewport.Y * 0.5)
            ui.tracer.From = Vector2.new(center.X, center.Y)
            ui.tracer.To = Vector2.new(point.X, point.Y)
            ui.tracer.Color = fovColor
            ui.tracer.Visible = true
        else
            ui.tracer.Visible = false
        end
    end

    -- Status bar (show speed instead of old smooth)
    ui.status.Text = string.format(
        "AIMBOT  |  %s  |  %s  |  SPEED %.2f  |  SPREAD %.0f%%",
        aimMode,
        candidate.player.DisplayName,
        settings.aimSpeed,
        settings.missSpread
    )

    -- Debug overlay
    if debugEnabled and ui.debug then
        ui.debug.Visible = true
        local toggleStr = toggleState and "ON" or "OFF"
        local mouseUIStr = IsMouseOverGui() and "YES" or "no"
        local targetStr = candidate and candidate.player.Name or "none"
        local targetDist = candidate and string.format("%.0f", candidate.distance) or "-"
        ui.debugText.Text = string.format(
            "FPS: %d\nMode: %s\nSpeed: %.2f\nToggle: %s\nMouseUI: %s\nTarget: %s [%s studs]\nTracer: %s\nSpread: %.0f%%",
            ui.fps,
            aimMode,
            settings.aimSpeed,
            toggleStr,
            mouseUIStr,
            targetStr,
            targetDist,
            tracerEnabled and "ON" or "OFF",
            settings.missSpread
        )
    elseif ui.debug then
        ui.debug.Visible = false
    end
end

-- 라이프사이클 -------------------------------------------------------------------
function AimBot.Start()
    if active then
        return
    end

    active = true
    errorReported = false
    aimKeyToggled = false
    aimbotToggled = false
    currentTarget = nil
    targetVelocity = Vector3.new(0, 0, 0)
    lastPosition = nil
    lastTime = 0
    frameSettings = nil
    ui.fps = 0
    ui.frames = 0
    ui.fpsTimer = 0

    CreateUI()

    -- Install silent aim hook if needed
    local settings = GetSettings()
    if settings.aimMode == "Silent" then
        InstallSilentHook()
    end

    -- Register input handler for toggle mode
    local inputConnection
    inputConnection = UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        OnInputBegan(input, gpe)
    end)

    connection = RunService.RenderStepped:Connect(function(deltaTime)
        if not active then
            return
        end

        -- Debug FPS counter: count frames, sample every 0.5s
        ui.frames += 1
        ui.fpsTimer += deltaTime or 0.016
        if ui.fpsTimer >= 0.5 then
            ui.fps = math.floor(ui.frames / ui.fpsTimer)
            ui.frames = 0
            ui.fpsTimer = 0
        end

        local ok, err = xpcall(function()
            -- Sync local toggle state from the UI keybind flag
            local bind = GetToggleKeyBind()
            if bind then
                aimbotToggled = bind.active == true
            end

            if not IsAimbotEnabled() then
                frameSettings = nil
                HideUI()
                currentTarget = nil
                return
            end

            local settings = GetSettings()
            frameSettings = settings
            local camera = GetCamera()
            local candidate, radius = FindBestCandidate()

            -- Store current target for silent aim hook
            currentTarget = candidate

            -- Update UI
            UpdateUI(candidate, radius)

            if not candidate or not camera then
                return
            end

            -- Execute aiming based on mode
            local shouldAim = ShouldAim(settings)
            if not shouldAim then
                return
            end

            -- Auto-disable while the cursor is over the cheat menu UI
            if IsMouseOverGui() then
                ui.status.Text = "AIMBOT  |  MOUSE OVER UI"
                return
            end

            if settings.aimMode == "Normal" then
                -- Normal mode: mouse-point camera rotation
                ExecuteNormalAim(candidate, camera, settings, deltaTime, radius)
            elseif settings.aimMode == "Silent" then
                -- Silent mode: NO camera movement. Only the raycast hook redirects
                -- shots (miss spread applies there); speed/smooth are ignored.
                if not silentHookInstalled then
                    ui.status.Text = "AIMBOT  |  SILENT (HOOK UNAVAILABLE)"
                end
            end
        end, debug.traceback)

        if not ok and not errorReported then
            errorReported = true
            warn("[AimBot] update failed: " .. tostring(err))
        end
    end)

    -- Store input connection for cleanup
    AimBot._inputConnection = inputConnection
end

function AimBot.Stop()
    active = false
    currentTarget = nil

    if connection then
        connection:Disconnect()
        connection = nil
    end

    if AimBot._inputConnection then
        AimBot._inputConnection:Disconnect()
        AimBot._inputConnection = nil
    end

    HideUI()

    if ui.gui then
        ui.gui:Destroy()
        ui.gui = nil
        ui.fov = nil
        ui.marker = nil
        ui.label = nil
        ui.status = nil
    end

    if ui.fovCircle then
        pcall(function()
            ui.fovCircle:Remove()
        end)
        ui.fovCircle = nil
    end

    if ui.tracer then
        pcall(function()
            ui.tracer:Remove()
        end)
        ui.tracer = nil
    end
end

return AimBot
