--[[===========================================================================
    Prison Life — Custom AimBot Module  v3
    ---------------------------------------------------------------------------
    로드 : local AimBot = loadstring(game:HttpGet("GITHUB_RAW_URL"))() ; AimBot.Start()
    연동 : getgenv().library.flags (PRISONLIFE.lua UI)

    v3 변경사항
      * smooth 의미 역전 : 높을수록 부드럽게(작은 스텝 글라이드), 낮을수록 노골적 스냅
      * 정상 조준 안정화 : 한 프레임당 이동량 캡 + 프레임마다 실제 마우스 좌표 재측정
        → "순간이동 하듯 튀는" 증상 제거
      * 락온 스티키 캐시 : 한 번 잡으면 적이 죽거나 화면 밖(FOV 마진)으로
        벗어나기 전까지 유지 → 프레임마다 타겟이 갈아끼워지면서
        마우스가 이리저리 튀는 문제 해결
      * Silent 락온 시각화 : 조준점에 크로스헤어 + 타겟 이름/거리 표시
        (노랑 = Blatant 매직불릿, 초록 = Silent)
      * Silent 발사 방향은 프레임마다 미리 계산한 락온을 재사용
        (메타메서드 호출마다 FindTarget 재실행하지 않음 → 성능 개선 + 안정)

    모드 계층
      [1] Normal      마우스 포인터 고정 (smooth)      조준 키 홀드
      [2] Silent      탄도만 변조 (miss spread)        조준 키 홀드
      [3] Blatant     매직 불릿 100% + 자동발사         Blatantaimbot_enabled 토글
      우선순위 : Blatant > Silent > Normal (동시 활성 가능)
==============================================================================]]

local AimBot = {}
AimBot.__index = AimBot

-- 서비스 ----------------------------------------------------------------------
local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer      = Players.LocalPlayer
local Camera           = workspace.CurrentCamera

local G    = getgenv() or _G
local Wait = task.wait
local Time = os.clock

-- 히트박스 부위 매핑 ------------------------------------------------------------
local HITBOX_PARTS = {
    head  = { "Head" },
    chest = { "HumanoidRootPart", "UpperTorso", "LowerTorso", "Torso" },
    legs  = { "HumanoidRootPart", "RightUpperLeg", "LeftUpperLeg", "RightLowerLeg", "LeftLowerLeg" },
}

-- 조준 키 매핑 --------------------------------------------------------------------
local AIM_KEY_TYPES = {
    ["Mouse Left"]   = Enum.UserInputType.MouseButton1,
    ["Mouse Right"]  = Enum.UserInputType.MouseButton2,
    ["Mouse Middle"] = Enum.UserInputType.MouseButton3,
    ["Keyboard"]     = nil,
}

-- 기본 플래그 ----------------------------------------------------------------------
local DEFAULT_FLAGS = {
    ["aimbot_enabled"]           = false,
    ["aimbot_Teamcheck"]         = true,
    ["aimbot_Wallcheck"]         = true,
    ["Aimbot Mode"]              = "Normal",
    ["AAimbot Key"]              = "Mouse Right",
    ["KB key"]                   = Enum.KeyCode.E,
    ["aimbot_smooth"]            = 6,   -- 높을수록 부드럽게 (10=부드러움, 0=스냅)
    ["aimbot_missspread"]        = 10,
    ["aimbot_fov"]               = 10,
    ["aimbot_maxdist"]           = 1500,
    ["aimbot_hitbox"]            = "head",
    ["aimbot_target_priority"]   = "Distance",   -- 세 모드 공용
    ["Blatantaimbot_enabled"]    = false,
    ["Blatantaimbot_fov"]        = 10,
    ["Blatantaimbot_maxdist"]    = 1500,
    ["Blatantaimbot_teamcheck"]  = true,
    ["Blatantaimbot_wallbang"]   = false,
    ["Blatantaimbot_hitbox"]     = "head",
    ["Blatantaimbot_autofire"]   = true,
    ["Blatantaimbot_useactivate"] = false,
}

local function GetFlag(name)
    local f = G.library and G.library.flags and G.library.flags[name]
    if f ~= nil then return f end
    return DEFAULT_FLAGS[name]
end

local function Clamp(v, lo, hi)
    return math.max(lo, math.min(hi, v))
end

local realMouse = LocalPlayer:GetMouse()

local function GetMousePos()
    local ok, v = pcall(function() return UserInputService:GetMouseLocation() end)
    if ok then return v end
    return Vector2.new(realMouse.X, realMouse.Y)
end

local function CharOf(player) return player.Character end

local function AliveHumanoid(player)
    local char = CharOf(player)
    if not char then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid") or char:FindFirstChild("Humanoid")
    if not hum or hum.Health <= 0 then return nil end
    local ok, state = pcall(function() return hum:GetState() end)
    if ok and state == Enum.HumanoidStateType.Dead then return nil end
    return hum
end

local function IsValidPlayer(p)
    return p ~= nil and p ~= LocalPlayer and CharOf(p) and AliveHumanoid(p)
end

-- 팀 체크 ----------------------------------------------------------------------
local function IsEnemy(player)
    if not player or player == LocalPlayer then return false end
    if not CharOf(player) then return false end
    local lp = LocalPlayer
    if player.Team ~= nil and lp.Team ~= nil and player.Team == lp.Team then
        return false
    end
    if player.TeamColor ~= nil and lp.TeamColor ~= nil
        and player.TeamColor == lp.TeamColor then
        return false
    end
    return true
end

-- 벽 체크 ---------------------------------------------------------------------------
local function RaycastVisible(origin, part, allowWallbang, wallcheck)
    if allowWallbang or not wallcheck then return true end
    local lpChar = CharOf(LocalPlayer)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Blacklist
    params.FilterDescendantsInstances = { lpChar, workspace.CurrentCamera }
    local result = workspace:Raycast(origin, part.Position - origin, params)
    if not result then return true end
    return result.Instance:IsDescendantOf(part.Parent)
end

-- 히트박스 파트 -----------------------------------------------------------------------
local function GetHitboxPart(character, key)
    for _, name in ipairs(HITBOX_PARTS[key] or HITBOX_PARTS.head) do
        local part = character:FindFirstChild(name)
        if part then return part end
    end
    return character:FindFirstChild("HumanoidRootPart")
        or character:FindFirstChild("Head")
end

-- Hurttime 트래커 -----------------------------------------------------------------------
local HurtTime = {}

local function TrackHurt(player)
    if HurtTime[player] then return end
    local hum = AliveHumanoid(player)
    if not hum then return end
    local entry = { time = 0, lastHealth = hum.Health, conn = nil }
    HurtTime[player] = entry
    entry.conn = hum.HealthChanged:Connect(function(newHealth)
        if newHealth < entry.lastHealth then
            entry.time = Time()
        end
        entry.lastHealth = newHealth
    end)
end

-- 설정 해석 -------------------------------------------------------------------------------
local function ResolveTargetSettings(blatant)
    if blatant then
        return Clamp(tonumber(GetFlag("Blatantaimbot_fov")) or 10, 0, 10) / 10,
               tonumber(GetFlag("Blatantaimbot_maxdist")) or 1500
    end
    return Clamp(tonumber(GetFlag("aimbot_fov")) or 10, 0, 10) / 10,
           tonumber(GetFlag("aimbot_maxdist")) or 1500
end

-- 타겟 파인더 (공통, opts.blatant에 따라 설정/히트박스 분리) --------------------------------
-- opts : hitKey / teamcheck / wallbang / blatant(불리언)
-- 우선순위는 aimbot_target_priority 공용
local function FindTarget(opts)
    opts = opts or {}

    local teamcheck = opts.teamcheck
    if teamcheck == nil then teamcheck = GetFlag("aimbot_Teamcheck") end

    local wallcheck     = GetFlag("aimbot_Wallcheck")
    local allowWallbang = opts.wallbang
    if allowWallbang == nil then allowWallbang = GetFlag("Blatantaimbot_wallbang") end

    local hitKey = opts.hitKey or tostring(GetFlag("aimbot_hitbox"))
    local fovRatio, maxDist = ResolveTargetSettings(opts.blatant)

    local origin   = Camera.CFrame.Position
    local mousePos = GetMousePos()
    local radius   = fovRatio * math.min(Camera.ViewportSize.X, Camera.ViewportSize.Y) * 0.5

    local priority = tostring(GetFlag("aimbot_target_priority"))
    local best, bestScore = nil, math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        if not IsValidPlayer(p) then continue end
        if teamcheck and not IsEnemy(p) then continue end

        local char = CharOf(p)
        local hum  = AliveHumanoid(p)
        if not char or not hum then continue end

        local dist = (char:GetPivot().Position - origin).Magnitude
        if dist > maxDist then continue end

        local part = GetHitboxPart(char, hitKey)
        if not part then continue end
        if not RaycastVisible(origin, part, allowWallbang, wallcheck) then continue end

        local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
        if not onScreen then continue end
        local screenDist = (mousePos - Vector2.new(sp.X, sp.Y)).Magnitude
        if screenDist > radius then continue end

        local score
        if priority == "Health" then
            score = hum.Health
        elseif priority == "Hurttime" then
            TrackHurt(p)
            score = -((HurtTime[p] and HurtTime[p].time) or 0)
        elseif priority == "Items" then
            local count = 0
            for _, ch in ipairs(char:GetChildren()) do
                if ch:IsA("Tool") or ch:IsA("Backpack") then count = count + 1 end
            end
            score = -count * 100 - dist * 0.001
        else -- Distance
            score = dist + screenDist * 0.001
        end

        if score < bestScore then
            best, bestScore = p, score
        end
    end

    return best
end

-- ================================================================================
-- 락온 스티키 캐시
--   한 번 타겟을 잡으면 유효한 동안 유지한다.
--   FOV 마진(1.5배) + 최대거리 마진(1.25배) 안이고 살아있고 보이면 계속 고수.
--   → 프레임마다 타겟이 바뀌면서 마우스가 튀는 증상 방지
-- ================================================================================
local Locks = {}

local function ValidLock(lock)
    return lock and lock.player and IsValidPlayer(lock.player)
        and lock.part and lock.part.Parent
end

local function AcquireLock(key, fovRatio, maxDist, opts)
    opts = opts or {}

    -- 기존 락 유지 판정
    local lock = Locks[key]
    if ValidLock(lock) then
        local char = CharOf(lock.player)
        local origin = Camera.CFrame.Position

        -- 파트 리프레시 (움직이는 리그 대비)
        local fresh = GetHitboxPart(char, opts.hitKey or "head")
        if fresh then lock.part = fresh end

        local dist = (char:GetPivot().Position - origin).Magnitude
        if dist > maxDist * 1.25 then lock = nil end

        if lock then
            local margin = fovRatio * math.min(Camera.ViewportSize.X, Camera.ViewportSize.Y) * 0.5 * 1.5
            local sp, onScreen = Camera:WorldToViewportPoint(lock.part.Position)
            local mousePos = GetMousePos()
            if not onScreen or (Vector2.new(sp.X, sp.Y) - mousePos).Magnitude > margin then
                lock = nil
            elseif not RaycastVisible(origin, lock.part, opts.wallbang or false, GetFlag("aimbot_Wallcheck")) then
                lock = nil
            end
        end
        if lock then return lock end
    end

    -- 새 타겟 탐색
    local target = FindTarget({
        blatant   = opts.blatant,
        hitKey    = opts.hitKey or tostring(GetFlag(not opts.blatant and "aimbot_hitbox" or "Blatantaimbot_hitbox")),
        teamcheck = opts.teamcheck,
        wallbang  = opts.wallbang,
    })
    if not target then
        Locks[key] = nil
        return nil
    end
    lock = {
        player = target,
        part = GetHitboxPart(CharOf(target), opts.hitKey or "head"),
    }
    Locks[key] = lock
    return lock
end

-- 조준 키 상태 ------------------------------------------------------------------------
local function AimKeyHeld()
    local keyName = tostring(GetFlag("AAimbot Key"))
    if keyName == "Keyboard" then
        local kb = GetFlag("KB key")
        if type(kb) == "string" then kb = Enum.KeyCode[kb] end
        return kb ~= nil and UserInputService:IsKeyDown(kb)
    end
    local t = AIM_KEY_TYPES[keyName]
    return t ~= nil and UserInputService:IsMouseButtonPressed(t)
end

-- 전투 장착 무기 ------------------------------------------------------------------------
local function CurrentTool()
    local char = CharOf(LocalPlayer)
    if not char then return nil end
    local equipped = char:FindFirstChildOfClass("Tool")
    if equipped then return equipped end
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then return backpack:FindFirstChildOfClass("Tool") end
    return nil
end

-- ================================================================================
-- [1] NORMAL — 마우스 포인터 고정
--   smooth : 10 = 부드러운 글라이드 (작은 스텝), 0 = 즉시 스냅
--   한 프레임당 최대 45px만 이동 → 순간이동/발진 방지
--   매 프레임 실제 마우스 좌표 재측정 → 누적 오차 없음
-- ================================================================================
local mousemoverel = G.mousemoverel
local mousemoveabs = G.mousemoveabs
local MAX_STEP = 45

local function NormalLock()
    if not AimKeyHeld() then return end

    local fovRatio, maxDist = ResolveTargetSettings(false)
    local lock = AcquireLock("normal", fovRatio, maxDist, {
        hitKey = tostring(GetFlag("aimbot_hitbox")),
    })
    if not lock then return end

    local part = lock.part
    local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
    if not onScreen then return end

    local mousePos = GetMousePos()
    local diff = Vector2.new(sp.X, sp.Y) - mousePos
    local dist = diff.Magnitude
    if dist < 1.5 then return end

    -- smooth 10 -> 3.5% 스텝(부드럽게), 0 -> 100% (스냅)
    local smooth = Clamp(tonumber(GetFlag("aimbot_smooth")) or 10, 0, 10)
    local strength = 0.035 + 0.965 * ((10 - smooth) / 10)

    local step = diff * strength
    if step.Magnitude > MAX_STEP then
        step = step.Unit * MAX_STEP
    end
    -- 막판 정밀 정착 : 25px 이내면 바로 스냅 (잔떨림 방지)
    if dist < 25 then step = diff end

    local vp = Camera.ViewportSize
    local dest = mousePos + step
    dest = Vector2.new(
        math.clamp(dest.X, 0, vp.X),
        math.clamp(dest.Y, 0, vp.Y)
    )

    if mousemoveabs then
        mousemoveabs(dest.X, dest.Y)
    elseif mousemoverel then
        mousemoverel(step.X, step.Y)
    end
end

-- ================================================================================
-- [2] SILENT / [3] BLATANT — 발사 방향 변조 (Mouse.Hit 훅)
-- ================================================================================
local SilentState = {
    aimPart    = nil,
    aimPoint   = Vector3.new(),
    missOffset = Vector3.new(),
    lastRoll   = 0,
}

-- Miss spread : 10 = 100%(빗나감 없음), 5 = 절반 확률로 넓게 빗나감
local function RollMissSpread(distance)
    local spread = Clamp(tonumber(GetFlag("aimbot_missspread")) or 10, 0, 10) / 10
    if spread >= 1 then
        SilentState.missOffset = Vector3.new()
        return
    end
    if math.random() < (1 - spread) then
        local radius = (0.35 + distance * 0.0025) * (1 - spread)
        local ang = math.random() * math.pi * 2
        local rad = math.random() * radius
        SilentState.missOffset = Vector3.new(
            math.cos(ang) * rad,
            (math.random() - 0.5) * radius * 1.6,
            math.sin(ang) * rad
        )
    else
        SilentState.missOffset = Vector3.new()
    end
end

-- 현재 활성 모드에 맞는 변조 CFrame 계산
-- 우선순위 : Blatant > Silent. 프레임마다 락온을 미리 계산해서 재사용.
local function ComputeAimCF()
    local enabled = GetFlag("aimbot_enabled")
    if not enabled then return nil end

    local keyHeld = AimKeyHeld()
    local origin = Camera.CFrame.Position

    -- 1) Blatant magic bullet : 독립 토글, 키 불필요
    if GetFlag("Blatantaimbot_enabled") then
        local lock = ValidLock(Locks["blatant"]) and Locks["blatant"]
        if not lock then
            local bFov, bDist = ResolveTargetSettings(true)
            lock = AcquireLock("blatant", bFov, bDist, {
                blatant   = true,
                hitKey    = tostring(GetFlag("Blatantaimbot_hitbox")),
                teamcheck = GetFlag("Blatantaimbot_teamcheck"),
                wallbang  = GetFlag("Blatantaimbot_wallbang"),
            })
        end
        if lock then
            SilentState.aimPart  = lock.part
            SilentState.aimPoint = lock.part.Position   -- miss spread 무시, 100% 확정
            return CFrame.lookAt(origin, SilentState.aimPoint)
        end
    end

    -- 2) Silent : 키 홀드 동안, miss spread 적용
    if tostring(GetFlag("Aimbot Mode")) == "Silent" and keyHeld then
        local lock = ValidLock(Locks["silent"]) and Locks["silent"]
        if not lock then
            local fovRatio, maxDist = ResolveTargetSettings(false)
            lock = AcquireLock("silent", fovRatio, maxDist, {
                hitKey = tostring(GetFlag("aimbot_hitbox")),
            })
        end
        if lock then
            local dist = (lock.part.Position - origin).Magnitude
            if Time() - SilentState.lastRoll > 0.1 then
                RollMissSpread(dist)
                SilentState.lastRoll = Time()
            end
            SilentState.aimPart  = lock.part
            SilentState.aimPoint = lock.part.Position + SilentState.missOffset
            return CFrame.lookAt(origin, SilentState.aimPoint)
        end
    end

    return nil
end

-- Mouse __index 훅 : 게임 스크립트가 Hit / UnitRay / Target 읽을 때 변조 ------------
local hookMeta, newCClosure, checkCaller = G.hookmetamethod, G.newcclosure, G.checkcaller
local hooked = false
local oldIndex = nil

local function InstallHook()
    if hooked then return true end
    if not (hookMeta and newCClosure and checkCaller) then
        warn("[AimBot] hookmetamethod 미지원 익스큐터 — Silent/Blatant 불가. Normal만 동작.")
        return false
    end

    oldIndex = hookMeta(game, "__index", newCClosure(function(self, key)
        if checkCaller() then return oldIndex(self, key) end

        if (key == "Hit" or key == "UnitRay" or key == "Target")
            and typeof(self) == "Instance" and rawequal(self, realMouse) then
            local ok, cf = pcall(ComputeAimCF)
            if ok and cf then
                if key == "Hit" then
                    return cf
                elseif key == "UnitRay" then
                    return Ray.new(cf.Position, cf.LookVector * math.huge)
                elseif key == "Target" then
                    local part = SilentState.aimPart
                    if part and part.Parent then return part end
                end
            end
        end
        return oldIndex(self, key)
    end))

    hooked = true
    return true
end

local function RemoveHook()
    if hooked and oldIndex then
        pcall(function() hookMeta(game, "__index", oldIndex) end)
    end
    hooked = false
    oldIndex = nil
end

-- ================================================================================
-- [3] BLATANT — 킬아우라식 자동 공격 (매직 불릿 락온 중 자동 발사)
-- ================================================================================
local nextFireAt = 0

local function BlatantAutoFire()
    if not GetFlag("Blatantaimbot_autofire") then return end
    if not GetFlag("aimbot_enabled") then return end
    if not GetFlag("Blatantaimbot_enabled") then return end

    local lock = ValidLock(Locks["blatant"]) and Locks["blatant"]
    if not lock then return end

    local tool = CurrentTool()
    if not tool then return end

    if Time() < nextFireAt then return end
    nextFireAt = Time() + 0.11

    local VIM = game:GetService("VirtualInputManager")
    local mp  = GetMousePos()
    VIM:SendMouseButtonEvent(mp.X, mp.Y, 0, true, game, 1)
    Wait(0.05)
    VIM:SendMouseButtonEvent(mp.X, mp.Y, 0, false, game, 1)

    -- tool:Activate() 직접 호출 : 기본 OFF
    -- (켜면 ClientItemHandler 류 아이템 처리 스크립트의 죽은 mouse.Position 접근 경로 발동
    --  → "Position is not a valid member of PlayerMouse" 에러 위험)
    if GetFlag("Blatantaimbot_useactivate") then
        pcall(function()
            if tool:IsA("Tool") then tool:Activate() end
        end)
    end
end

-- 발사 입력 시 miss spread 즉석 리롤 (Silent 정확도 체감용) -------------------------
local function OnInputBegan(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
    if not GetFlag("aimbot_enabled") then return end
    if tostring(GetFlag("Aimbot Mode")) ~= "Silent" then return end

    local part = SilentState.aimPart
    if not part then return end
    local dist = (part.Position - Camera.CFrame.Position).Magnitude
    RollMissSpread(dist)
    SilentState.lastRoll = Time()
end

-- ================================================================================
-- 시각화 : FOV 서클 + 락온 크로스헤어
-- ================================================================================
local normalCircle   = nil
local blatantCircle  = nil

local Crosshair = { lines = {}, text = nil, active = false }
local CrosshairVisible = false

local function EnsureFOVCircles()
    if not normalCircle then
        local ok = pcall(function()
            normalCircle = Drawing.new("Circle")
            normalCircle.Thickness = 1.5
            normalCircle.NumSides = 64
            normalCircle.Color = Color3.fromRGB(255, 70, 70)
            normalCircle.Transparency = 1
            normalCircle.Filled = false
        end)
        if not ok then normalCircle = nil end
    end
    if not blatantCircle then
        local ok = pcall(function()
            blatantCircle = Drawing.new("Circle")
            blatantCircle.Thickness = 2
            blatantCircle.NumSides = 64
            blatantCircle.Color = Color3.fromRGB(255, 200, 40)
            blatantCircle.Transparency = 1
            blatantCircle.Filled = false
        end)
        if not ok then blatantCircle = nil end
    end
end

local function EnsureCrosshair()
    if Crosshair.active then return end
    local okAll = true
    for i = 1, 4 do
        local ok, line = pcall(function()
            local l = Drawing.new("Line")
            l.Thickness = 1.5
            l.Transparency = 1
            l.Color = Color3.fromRGB(70, 255, 120)
            l.Visible = false
            return l
        end)
        if not ok then okAll = false break end
        Crosshair.lines[i] = line
    end
    if not okAll then
        Crosshair.lines = {}
        return
    end
    pcall(function()
        local t = Drawing.new("Text")
        t.Size = 14
        t.Center = true
        t.Outline = true
        t.OutlineColor = Color3.fromRGB(20, 20, 20)
        t.Color = Color3.fromRGB(255, 255, 255)
        t.Transparency = 1
        t.Visible = false
        Crosshair.text = t
    end)
    Crosshair.active = true
end

local function DrawLockCrosshair(center, color, label)
    if not Crosshair.active then return end
    local gap, len = 7, 13
    local pts = {
        { Vector2.new(center.X - len, center.Y), Vector2.new(center.X - gap, center.Y) },
        { Vector2.new(center.X + gap, center.Y), Vector2.new(center.X + len, center.Y) },
        { Vector2.new(center.X, center.Y - len), Vector2.new(center.X, center.Y - gap) },
        { Vector2.new(center.X, center.Y + gap), Vector2.new(center.X, center.Y + len) },
    }
    for i = 1, 4 do
        local l = Crosshair.lines[i]
        if l then
            l.From = pts[i][1]
            l.To = pts[i][2]
            l.Color = color
            l.Visible = CrosshairVisible
        end
    end
    if Crosshair.text then
        Crosshair.text.Position = center + Vector2.new(0, 26)
        Crosshair.text.Text = label
        Crosshair.text.Visible = CrosshairVisible
    end
end

local function HideCrosshair()
    if not Crosshair.active then return end
    for _, l in ipairs(Crosshair.lines) do
        if l then l.Visible = false end
    end
    if Crosshair.text then Crosshair.text.Visible = false end
end

-- 락온 시각화 : Silent = 초록, Blatant = 노랑
local function UpdateLockVisual()
    local enabled = GetFlag("aimbot_enabled")
    if not enabled then
        CrosshairVisible = false
        HideCrosshair()
        return
    end

    local lock = nil
    local color = Color3.fromRGB(70, 255, 120)
    if GetFlag("Blatantaimbot_enabled") and ValidLock(Locks["blatant"]) then
        lock = Locks["blatant"]
        color = Color3.fromRGB(255, 200, 40)
    elseif tostring(GetFlag("Aimbot Mode")) == "Silent"
        and AimKeyHeld() and ValidLock(Locks["silent"]) then
        lock = Locks["silent"]
    end

    if not lock then
        CrosshairVisible = false
        HideCrosshair()
        return
    end

    local sp, onScreen = Camera:WorldToViewportPoint(lock.part.Position)
    if not onScreen then
        CrosshairVisible = false
        HideCrosshair()
        return
    end

    CrosshairVisible = true
    local dist = (lock.part.Position - Camera.CFrame.Position).Magnitude
    local name = pcall(function() return lock.player.DisplayName end) and lock.player.DisplayName or lock.player.Name
    DrawLockCrosshair(
        Vector2.new(sp.X, sp.Y),
        color,
        string.format("%s  %.0fm", name, dist)
    )
end

-- ================================================================================
-- 라이프사이클
-- ================================================================================
local connections = {}
local active = false

function AimBot.Start()
    if active then return end
    active = true

    EnsureFOVCircles()
    EnsureCrosshair()
    if not InstallHook() then
        warn("[AimBot] Silent/Blatant 비활성 — Normal만 사용 가능")
    end

    for _, p in ipairs(Players:GetPlayers()) do TrackHurt(p) end

    local render = RunService.RenderStepped:Connect(function()
        if not active then return end

        local enabled = GetFlag("aimbot_enabled")
        local mode = tostring(GetFlag("Aimbot Mode"))

        if not enabled then
            if normalCircle then normalCircle.Visible = false end
            if blatantCircle then blatantCircle.Visible = false end
            CrosshairVisible = false
            HideCrosshair()
            return
        end

        -- Normal : 키 홀드 중 마우스 이동
        if mode == "Normal" then
            NormalLock()
        end

        -- Silent : 키 홀드 중 락온 사전 계산 (크로스헤어 표시 + 훅 재사용)
        if mode == "Silent" then
            if AimKeyHeld() then
                local fovRatio, maxDist = ResolveTargetSettings(false)
                AcquireLock("silent", fovRatio, maxDist, {
                    hitKey = tostring(GetFlag("aimbot_hitbox")),
                })
            else
                Locks["silent"] = nil
            end
        end

        -- Blatant : 독립 토글, 상시 락온 + 자동발사
        if GetFlag("Blatantaimbot_enabled") then
            local bFov, bDist = ResolveTargetSettings(true)
            AcquireLock("blatant", bFov, bDist, {
                blatant   = true,
                hitKey    = tostring(GetFlag("Blatantaimbot_hitbox")),
                teamcheck = GetFlag("Blatantaimbot_teamcheck"),
                wallbang  = GetFlag("Blatantaimbot_wallbang"),
            })
            BlatantAutoFire()
        else
            Locks["blatant"] = nil
        end

        -- FOV 서클
        if normalCircle then
            normalCircle.Position = GetMousePos()
            local normalFov = Clamp(tonumber(GetFlag("aimbot_fov")) or 10, 0, 10) / 10
            normalCircle.Radius = normalFov * math.min(Camera.ViewportSize.X, Camera.ViewportSize.Y) * 0.5
            normalCircle.Visible = (mode == "Normal" or mode == "Silent")
        end
        if blatantCircle then
            blatantCircle.Position = GetMousePos()
            local bFov = Clamp(tonumber(GetFlag("Blatantaimbot_fov")) or 10, 0, 10) / 10
            blatantCircle.Radius = bFov * math.min(Camera.ViewportSize.X, Camera.ViewportSize.Y) * 0.5
            blatantCircle.Visible = GetFlag("Blatantaimbot_enabled")
        end

        -- 락온 크로스헤어
        UpdateLockVisual()
    end)
    table.insert(connections, render)

    local input = UserInputService.InputBegan:Connect(OnInputBegan)
    table.insert(connections, input)

    local pa = Players.PlayerAdded:Connect(TrackHurt)
    table.insert(connections, pa)
end

function AimBot.Stop()
    active = false
    for _, conn in ipairs(connections) do
        pcall(function() conn:Disconnect() end)
    end
    connections = {}

    RemoveHook()

    if normalCircle then
        pcall(function() normalCircle:Remove() end)
        normalCircle = nil
    end
    if blatantCircle then
        pcall(function() blatantCircle:Remove() end)
        blatantCircle = nil
    end
    if Crosshair.active then
        for _, l in ipairs(Crosshair.lines) do
            if l then pcall(function() l:Remove() end) end
        end
        if Crosshair.text then pcall(function() Crosshair.text:Remove() end) end
        Crosshair.lines = {}
        Crosshair.text = nil
        Crosshair.active = false
    end
    CrosshairVisible = false

    for k in pairs(Locks) do Locks[k] = nil end

    for k, v in pairs(HurtTime) do
        if v.conn then pcall(function() v.conn:Disconnect() end) end
        HurtTime[k] = nil
    end
end

-- UI 토글 "enabled" 켜진 채로 로드되면 자동 시작 ------------------------------------
task.delay(0.5, function()
    if GetFlag("aimbot_enabled") then
        AimBot.Start()
    end
end)

return AimBot
