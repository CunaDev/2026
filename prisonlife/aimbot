local function HideUI()
    if ui.fov then ui.fov.Visible = false end
    if ui.marker then ui.marker.Visible = false end
    if ui.label then ui.label.Visible = false end
    if ui.tracer then ui.tracer.Visible = false end
    if ui.status then
        ui.status.Text = "AIMBOT  |  OFF"
    end
end

local function UpdateUI(candidate, radius)
    local camera = GetCamera()
    if not camera or not ui.gui then
        return
    end

    local settings = GetSettings()
    local mousePosition = GetMousePosition()
    local diameter = radius * 2

    -- FOV circle
    ui.fov.Position = UDim2.fromOffset(mousePosition.X - radius, mousePosition.Y - radius)
    ui.fov.Size = UDim2.fromOffset(diameter, diameter)
    ui.fov.Visible = GetFlag("aimbot_enabled") == true

    if not candidate then
        ui.marker.Visible = false
        ui.label.Visible = false
        if ui.tracer then ui.tracer.Visible = false end
        ui.status.Text = "AIMBOT  |  NO CANDIDATE"
        return
    end

    local point = candidate.screenPoint
    local healthColor = GetHealthColor(candidate.humanoid.Health, candidate.humanoid.MaxHealth)

    -- Target marker with health-based color
    ui.marker.Position = UDim2.fromOffset(point.X, point.Y)
    ui.marker.BackgroundColor3 = settings.blatant
        and Color3.fromRGB(255, 200, 40)
        or healthColor
    ui.marker.Visible = true

    -- Info label
    local aimMode = settings.aimMode
    if settings.blatant then
        aimMode = "BLATANT"
    end
    local keyState = ""
    if settings.keyMode == "Toggle" then
        keyState = aimKeyToggled and " [ON]" or " [OFF]"
    else
        keyState = IsAimKeyPressed(settings) and " [HOLD]" or " [--]"
    end

    ui.label.Position = UDim2.fromOffset(point.X, point.Y + 12)
    ui.label.Text = string.format(
        "[%s] %s | %s | %.0f studs | HP %.0f/%.0f | %s%s",
        aimMode,
        candidate.player.DisplayName,
        candidate.player.Team and candidate.player.Team.Name or "NoTeam",
        candidate.distance,
        candidate.humanoid.Health,
        candidate.humanoid.MaxHealth,
        tostring(GetFlag("aimbot_target_priority")),
        keyState
    )
    ui.label.Visible = true

    -- Tracer from crosshair to target
    if ui.tracer then
        local viewport = camera.ViewportSize
        local center = Vector2.new(viewport.X * 0.5, viewport.Y * 0.5)
        ui.tracer.From = Vector2.new(center.X, center.Y)
        ui.tracer.To = Vector2.new(point.X, point.Y)
        ui.tracer.Color = healthColor
        ui.tracer.Visible = true
    end

    ui.status.Text = string.format(
        "AIMBOT  |  %s  |  %s  |  SMOOTH %.1f  |  SPREAD %.0f%%",
        aimMode,
        candidate.player.DisplayName,
        settings.smooth,
        settings.missSpread
    )
end

-- 라이프사이클 -------------------------------------------------------------------
function AimBot.Start()
    if active then
        return
    end

    active = true
    errorReported = false
    aimKeyToggled = false
    currentTarget = nil
    targetVelocity = Vector3.new(0, 0, 0)
    lastPosition = nil
    lastTime = 0
    triggerbotCooldown = 0

    CreateUI()

    -- Install silent aim hook if needed
    local settings = GetSettings()
    if settings.aimMode == "Silent" or settings.blatant then
        InstallSilentHook()
    end

    -- Register input handler for toggle mode
    local inputConnection
    inputConnection = UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        OnInputBegan(input, gpe)
    end)

    connection = RunService.RenderStepped:Connect(function()
        if not active then
            return
        end

        local ok, err = xpcall(function()
            if GetFlag("aimbot_enabled") ~= true then
                HideUI()
                currentTarget = nil
                return
            end

            local settings = GetSettings()
            local camera = GetCamera()
            local candidate, radius = FindBestCandidate()

            -- Store current target for silent aim hook
            currentTarget = candidate

            -- Update UI
            UpdateUI(candidate, radius)

            if not candidate or not camera then
                return
            end

            -- Execute aiming based on mode
            local shouldAim = ShouldAim(settings)
            if not shouldAim then
                return
            end

            if settings.aimMode == "Normal" then
                -- Normal mode: smooth camera aim
                ExecuteNormalAim(candidate, camera, settings)
            elseif settings.aimMode == "Silent" then
                if silentHookInstalled then
                    -- Silent aim via hook already handles raycast redirection
                    -- Optionally move camera slightly for visual feedback
                    if settings.smooth > 0 then
                        ExecuteNormalAim(candidate, camera, settings)
                    end
                else
                    -- Fallback: camera snap (less stealthy)
                    ExecuteNormalAim(candidate, camera, settings)
                end
            elseif settings.blatant then
                -- Blatant: aggressive aim with hook
                ExecuteNormalAim(candidate, camera, settings)
            end

            -- Triggerbot
            if settings.aimMode == "Silent" or settings.blatant then
                ExecuteTriggerbot(candidate, tick())
            end
        end, debug.traceback)

        if not ok and not errorReported then
            errorReported = true
            warn("[AimBot] update failed: " .. tostring(err))
        end
    end)

    -- Store input connection for cleanup
    AimBot._inputConnection = inputConnection
end

function AimBot.Stop()
    active = false
    currentTarget = nil

    if connection then
        connection:Disconnect()
        connection = nil
    end

    if AimBot._inputConnection then
        AimBot._inputConnection:Disconnect()
        AimBot._inputConnection = nil
    end

    HideUI()

    if ui.gui then
        ui.gui:Destroy()
        ui.gui = nil
        ui.fov = nil
        ui.marker = nil
        ui.label = nil
        ui.status = nil
    end

    if ui.tracer then
        pcall(function()
            ui.tracer:Remove()
        end)
        ui.tracer = nil
    end
end

return AimBot
