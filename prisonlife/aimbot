local AimBot = {}

-- Services
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")
local Workspace = game:GetService("Workspace")
local VirtualInputManager = game:GetService("VirtualInputManager")
local LocalPlayer = Players.LocalPlayer

local function GetEnvironment()
    if type(getgenv) == "function" then return getgenv() end
    return _G
end
local Environment = GetEnvironment()

-- Default flags
local DEFAULT_FLAGS = {
    aimbot_enabled = false,
    aimbot_Teamcheck = true,
    aimbot_Wallcheck = true,
    aimbot_fov = 5,
    aimbot_maxdist = 300,
    aimbot_hitbox = "head",
    aimbot_target_priority = "Smart",
    prisoner_execute_check = false,
    Blatantaimbot_enabled = false,
    Blatantaimbot_fov = 10,
    Blatantaimbot_maxdist = 1500,
    Blatantaimbot_teamcheck = true,
    Blatantaimbot_hitbox = "head",
    ["aimbot_smooth"] = 4,
    ["aimbot_missspread"] = 56,
    ["Aimbot Mode"] = "Normal",
    ["AAimbot Key"] = "Mouse Right",
    ["KB key"] = nil,
    ["aimbot_key_mode"] = "Hold",
}

-- Module state
local connection = nil
local active = false
local errorReported = false
local currentTarget = nil
local targetVelocity = Vector3.new(0, 0, 0)
local lastPosition = nil
local lastTime = 0
local aimKeyHeld = false
local aimKeyToggled = false
local silentHookInstalled = false
local triggerbotCooldown = 0

local function GetFlag(name)
    local library = Environment.library
    local flags = library and library.flags
    local value = flags and flags[name]
    if value ~= nil then
        return value
    end
    return DEFAULT_FLAGS[name]
end

local function Clamp(value, minimum, maximum)
    return math.max(minimum, math.min(maximum, value))
end

-- Math helpers
local function Lerp(a, b, t)
    return a + (b - a) * t
end

local function LerpAngle(a, b, t)
    local diff = b - a
    if diff > math.pi then
        diff = diff - 2 * math.pi
    elseif diff < -math.pi then
        diff = diff + 2 * math.pi
    end
    return a + diff * t
end

local function VectorLerp(a, b, t)
    return Vector3.new(
        Lerp(a.X, b.X, t),
        Lerp(a.Y, b.Y, t),
        Lerp(a.Z, b.Z, t)
    )
end

local function GetCamera()
    return workspace.CurrentCamera
end

local function GetMousePosition()
    local ok, position = pcall(function()
        return UserInputService:GetMouseLocation()
    end)
    if ok and typeof(position) == "Vector2" then
        return position
    end
    local camera = GetCamera()
    if camera then
        local viewport = camera.ViewportSize
        return Vector2.new(viewport.X * 0.5, viewport.Y * 0.5)
    end
    return Vector2.new(0, 0)
end

local function GetCharacter(player)
    return player and player.Character
end

local function GetHumanoid(player)
    local character = GetCharacter(player)
    if not character then
        return nil
    end
    return character:FindFirstChildOfClass("Humanoid")
end

local function IsAlive(player)
    local humanoid = GetHumanoid(player)
    return humanoid and humanoid.Health > 0
end

local function IsEnemy(player)
    if not player or player == LocalPlayer then
        return false
    end
    if player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
        return false
    end
    if player.TeamColor and LocalPlayer.TeamColor and player.TeamColor == LocalPlayer.TeamColor then
        return false
    end
    return true
end

local HOSTILE_ATTRIBUTES = {
    "EquippedHostileTool",
    "Hostile",
    "PunchedSomeone",
  --"Trespassing",
}

local function HasHostileAttribute(player)
    local character = GetCharacter(player)
    if not character then
        return false
    end

    -- Prison Life player model attributes are authoritative for this check.
    -- Attribute value must be actual boolean true; truthy strings are ignored.
    for _, attributeName in ipairs(HOSTILE_ATTRIBUTES) do
        if character:GetAttribute(attributeName) == true then
            return true
        end
    end

    return false
end

local function CanExecute(player)
    if not GetFlag("prisoner_execute_check") then
        return true
    end

    -- 처형 규칙은 Guards가 Inmates를 대상으로 할 때만 적용.
    if not LocalPlayer.Team or LocalPlayer.Team.Name ~= "Guards" then
        return true
    end
    if not player.Team or player.Team.Name ~= "Inmates" then
        return true
    end

    return HasHostileAttribute(player)
end

local HITBOX_PARTS = {
    head = { "Head" },
    chest = { "HumanoidRootPart", "UpperTorso", "LowerTorso", "Torso" },
    legs = { "HumanoidRootPart", "RightUpperLeg", "LeftUpperLeg", "RightLowerLeg", "LeftLowerLeg" },
}

local function GetPart(player, hitbox)
    local character = GetCharacter(player)
    if not character then
        return nil
    end

    for _, name in ipairs(HITBOX_PARTS[hitbox] or HITBOX_PARTS.head) do
        local part = character:FindFirstChild(name)
        if part and part:IsA("BasePart") then
            return part
        end
    end

    return character:FindFirstChild("HumanoidRootPart")
        or character:FindFirstChild("Head")
end

local function IsVisible(camera, part)
    if not GetFlag("aimbot_Wallcheck") then
        return true
    end

    local character = GetCharacter(LocalPlayer)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { character, camera }

    local result = workspace:Raycast(camera.CFrame.Position, part.Position - camera.CFrame.Position, params)
    return not result or result.Instance:IsDescendantOf(part.Parent)
end

local function GetSettings()
    local blatant = GetFlag("Blatantaimbot_enabled") == true
    local fovValue = tonumber(GetFlag(blatant and "Blatantaimbot_fov" or "aimbot_fov")) or 5
    local maxDistance = tonumber(GetFlag(blatant and "Blatantaimbot_maxdist" or "aimbot_maxdist")) or 300
    local hitbox = tostring(GetFlag(blatant and "Blatantaimbot_hitbox" or "aimbot_hitbox"))
    local teamcheck = GetFlag(blatant and "Blatantaimbot_teamcheck" or "aimbot_Teamcheck")

    -- New engine settings from PRISONLIFE.lua
    local smooth = tonumber(GetFlag("aimbot_smooth")) or 4
    local missSpread = tonumber(GetFlag("aimbot_missspread")) or 56
    local aimMode = tostring(GetFlag("Aimbot Mode") or "Normal")
    local aimKey = tostring(GetFlag("AAimbot Key") or "Mouse Right")
    local keyMode = tostring(GetFlag("aimbot_key_mode") or "Hold")

    return {
        blatant = blatant,
        fov = Clamp(fovValue, 0, 10) / 10,
        maxDistance = math.max(maxDistance, 0),
        hitbox = hitbox,
        teamcheck = teamcheck,
        smooth = Clamp(smooth, 0, 10),
        missSpread = Clamp(missSpread, 0, 100),
        aimMode = aimMode,
        aimKey = aimKey,
        keyMode = keyMode,
    }
end

-- Prediction: track target velocity and lead the shot
local function UpdatePrediction(part, now)
    local dt = now - lastTime
    if dt >= 0.05 and lastPosition then
        local velocity = (part.Position - lastPosition) / dt
        -- Exponential smoothing on velocity to avoid jitter
        targetVelocity = VectorLerp(targetVelocity, velocity, 0.35)
    else
        targetVelocity = targetVelocity * 0.9
    end
    lastPosition = part.Position
    lastTime = now
end

local function GetPredictedPosition(part, settings)
    if not lastPosition then
        return part.Position
    end
    -- Lead time scales with distance, capped at 0.5 studs per stud of distance
    local leadTime = Clamp(settings.maxDistance / 300, 0.05, 0.8)
    local predicted = part.Position + targetVelocity * leadTime
    -- Keep vertical prediction dampened for ground targets
    predicted = Vector3.new(predicted.X, part.Position.Y, predicted.Z)
    return predicted
end

-- Miss spread: angular random offset proportional to flag (0-100 -> 0-~15 degrees)
local function ApplyMissSpread(direction, spread, distance)
    if spread <= 0 then
        return direction
    end
    local maxAngle = math.rad(spread * 0.15) -- 0-100 -> 0-15 deg
    local theta = math.random() * math.pi * 2
    local phi = math.acos(2 * math.random() - 1)
    local offset = Vector3.new(
        math.sin(phi) * math.cos(theta),
        math.sin(phi) * math.sin(theta),
        math.cos(phi)
    ) * math.tan(maxAngle) * distance

    local displaced = direction * distance + offset
    return displaced.Unit
end

-- Key handling ---------------------------------------------------------------
local KEY_TO_MOUSE = {
    ["Mouse Left"] = Enum.UserInputType.MouseButton1,
    ["Mouse Right"] = Enum.UserInputType.MouseButton2,
    ["Mouse Middle"] = Enum.UserInputType.MouseButton3,
}

local function GetKeybindKey()
    local kbFlag = GetFlag("KB key")
    if type(kbFlag) == "table" then
        local key = kbFlag.key or kbFlag.Value or kbFlag.Enum
        if type(key) == "userdata" and typeof(key) == "EnumItem" then
            return key
        end
        if type(key) == "string" then
            local ok, resolved = pcall(function()
                return Enum.KeyCode[key]
            end)
            if ok and resolved then
                return resolved
            end
        end
    end
    return nil
end

local function IsAimKeyPressed(settings)
    local key = settings.aimKey
    local mouseType = KEY_TO_MOUSE[key]
    if mouseType then
        return UserInputService:IsMouseButtonPressed(mouseType)
    end
    if key == "Keyboard" then
        local code = GetKeybindKey()
        if code then
            return UserInputService:IsKeyDown(code)
        end
    end
    return false
end

local function ShouldAim(settings)
    if settings.keyMode == "Toggle" then
        return aimKeyToggled
    end
    return IsAimKeyPressed(settings)
end

local function ScoreCandidate(candidate, settings, mousePosition, radius)
    local priority = tostring(GetFlag("aimbot_target_priority"))
    local health = candidate.humanoid.Health
    local maxHealth = math.max(candidate.humanoid.MaxHealth, 1)
    local distanceScore = candidate.distance / math.max(settings.maxDistance, 1)
    local pointScore = candidate.screenDistance / math.max(radius, 1)
    local healthScore = health / maxHealth

    if priority == "Point" then
        return -candidate.screenDistance -- higher is better, negate for sort
    elseif priority == "Health" then
        return -health
    elseif priority == "Distance" then
        return -candidate.distance
    elseif priority == "Hurttime" then
        return -(candidate.hurtTime or 0)
    elseif priority == "Items" then
        return -(candidate.itemCount or 0) * 100 + candidate.distance * 0.001
    elseif priority == "Random" then
        return math.random()
    end

    -- Smart: weighted combination of screen proximity, distance, and health
    return -(pointScore * 0.40 + distanceScore * 0.35 + healthScore * 0.25)
end

local function FindBestCandidate()
    local camera = GetCamera()
    if not camera then
        return nil, 0
    end

    local settings = GetSettings()
    local mousePosition = GetMousePosition()
    local radius = settings.fov * math.min(camera.ViewportSize.X, camera.ViewportSize.Y) * 0.5
    local origin = camera.CFrame.Position
    local candidates = {}
    local now = tick()

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and IsAlive(player) then
            if (not settings.teamcheck or IsEnemy(player)) and CanExecute(player) then
                local humanoid = GetHumanoid(player)
                local part = GetPart(player, settings.hitbox)
                if humanoid and part then
                    -- Update prediction for this player
                    UpdatePrediction(part, now)
                    local predictedPos = GetPredictedPosition(part, settings)
                    local distance = (part.Position - origin).Magnitude
                    local screenPoint, onScreen = camera:WorldToViewportPoint(predictedPos)
                    local screenDistance = (Vector2.new(screenPoint.X, screenPoint.Y) - mousePosition).Magnitude

                    if onScreen and distance <= settings.maxDistance and screenDistance <= radius then
                        if IsVisible(camera, part) then
                            local itemCount = 0
                            for _, child in ipairs(GetCharacter(player):GetChildren()) do
                                if child:IsA("Tool") then
                                    itemCount = itemCount + 1
                                end
                            end

                            local candidate = {
                                player = player,
                                humanoid = humanoid,
                                part = part,
                                predictedPosition = predictedPos,
                                distance = distance,
                                screenPoint = Vector2.new(screenPoint.X, screenPoint.Y),
                                screenDistance = screenDistance,
                                itemCount = itemCount,
                            }
                            candidate.score = ScoreCandidate(candidate, settings, mousePosition, radius)
                            table.insert(candidates, candidate)
                        end
                    end
                end
            end
        end
    end

    if #candidates == 0 then
        return nil, radius
    end

    table.sort(candidates, function(left, right)
        return left.score > right.score -- higher score = better
    end)

    return candidates[1], radius
end
-- Aim execution ----------------------------------------------------------------

-- Normal aim: smooth camera lerp toward target
local function ExecuteNormalAim(candidate, camera, settings)
    local targetPos = candidate.predictedPosition or candidate.part.Position
    local direction = (targetPos - camera.CFrame.Position).Unit
    local smooth = settings.smooth
    local spread = settings.missSpread

    -- Apply miss spread
    if spread > 0 then
        direction = ApplyMissSpread(direction, spread, candidate.distance)
    end

    local lookCF = CFrame.lookAt(camera.CFrame.Position, camera.CFrame.Position + direction * 1000)

    if smooth > 0 then
        -- Smooth factor: higher smooth = slower rotation
        local factor = 1 - math.exp(-15 / (smooth + 1) * (RunService.RenderStepped:Wait() or 0.016))
        camera.CFrame = camera.CFrame:Lerp(lookCF, Clamp(factor, 0, 1))
    else
        camera.CFrame = lookCF
    end
end

-- Silent aim: install metamethod hook on Raycast to redirect hits
local function InstallSilentHook()
    if silentHookInstalled then
        return
    end

    local success = pcall(function()
        local oldHook
        oldHook = hookmetamethod(game, "__namecall", function(self, ...)
            local method = getnamecallmethod()

            -- Intercept raycast calls when aiming is active
            if method == "Raycast" or method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRay" then
                if active and GetFlag("aimbot_enabled") == true and currentTarget then
                    local settings = GetSettings()
                    local shouldAim = ShouldAim(settings)
                    if shouldAim and (settings.aimMode == "Silent" or settings.blatant) then
                        local targetPos = currentTarget.predictedPosition or currentTarget.part.Position
                        local camera = GetCamera()
                        if camera then
                            local direction = (targetPos - camera.CFrame.Position).Unit
                            local spread = settings.missSpread
                            if spread > 0 then
                                direction = ApplyMissSpread(direction, spread, currentTarget.distance)
                            end

                            if method == "Raycast" then
                                local params = RaycastParams.new()
                                params.FilterType = Enum.RaycastFilterType.Blacklist
                                params.FilterDescendantsInstances = {
                                    GetCharacter(LocalPlayer),
                                    camera,
                                }
                                return Workspace:Raycast(
                                    camera.CFrame.Position,
                                    direction * (currentTarget.distance + 50),
                                    params
                                )
                            else
                                -- Legacy FindPartOnRay methods
                                local args = {...}
                                local newRay = Ray.new(camera.CFrame.Position, direction * 2000)
                                args[1] = newRay
                                return self[method](self, unpack(args))
                            end
                        end
                    end
                end
            end

            return self[method](self, ...)
        end)
    end)

    if success then
        silentHookInstalled = true
    end
end

-- Triggerbot: auto-fire when locked on target
local function ExecuteTriggerbot(candidate, now)
    if not candidate or not GetFlag("aimbot_enabled") then
        return
    end

    local settings = GetSettings()
    if not ShouldAim(settings) then
        return
    end

    -- Only trigger in silent or blatant mode
    if settings.aimMode ~= "Silent" and not settings.blatant then
        return
    end

    -- Cooldown to prevent spam
    if now - triggerbotCooldown < 0.2 then
        return
    end

    triggerbotCooldown = now

    -- Simulate mouse click
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, nil, 0)
        task.wait(0.035)
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, nil, 0)
    end)
end

-- Toggle key input handler
local function OnInputBegan(input, gameProcessed)
    if gameProcessed then
        return
    end
    if not active or not GetFlag("aimbot_enabled") then
        return
    end

    local settings = GetSettings()
    if settings.keyMode ~= "Toggle" then
        return
    end

    local key = settings.aimKey
    local matches = false

    if key == "Mouse Left" and input.UserInputType == Enum.UserInputType.MouseButton1 then
        matches = true
    elseif key == "Mouse Right" and input.UserInputType == Enum.UserInputType.MouseButton2 then
        matches = true
    elseif key == "Mouse Middle" and input.UserInputType == Enum.UserInputType.MouseButton3 then
        matches = true
    elseif key == "Keyboard" then
        local code = GetKeybindKey()
        if code and input.KeyCode == code then
            matches = true
        end
    end

    if matches then
        aimKeyToggled = not aimKeyToggled
    end
end

-- UI ---------------------------------------------------------------------------
local ui = {
    gui = nil,
    fov = nil,
    marker = nil,
    label = nil,
    status = nil,
    tracer = nil,
}

local function CreateFrame(parent, color, transparency)
    local frame = Instance.new("Frame")
    frame.BackgroundColor3 = color
    frame.BackgroundTransparency = transparency
    frame.BorderSizePixel = 0
    frame.Parent = parent
    return frame
end

local function GetHealthColor(health, maxHealth)
    local ratio = health / math.max(maxHealth, 1)
    if ratio > 0.7 then
        return Color3.fromRGB(70, 255, 120) -- green
    elseif ratio > 0.4 then
        return Color3.fromRGB(255, 200, 40) -- yellow
    else
        return Color3.fromRGB(255, 60, 60) -- red
    end
end

local function SetupDrawingTracer()
    -- Try to use Drawing library for line rendering (better performance)
    local ok, drawing = pcall(function()
        return Drawing.new("Line")
    end)
    if ok and drawing then
        ui.tracer = drawing
        ui.tracer.Thickness = 1.5
        ui.tracer.Transparency = 0.6
        ui.tracer.Visible = false
        return true
    end
    return false
end

