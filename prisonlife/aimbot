local function CreateFrame(parent, color, transparency)
    local frame = Instance.new("Frame")
    frame.BackgroundColor3 = color
    frame.BackgroundTransparency = transparency
    frame.BorderSizePixel = 0
    frame.Parent = parent
    return frame
end

local function GetHealthColor(health, maxHealth)
    local ratio = health / math.max(maxHealth, 1)
    if ratio > 0.7 then
        return Color3.fromRGB(70, 255, 120) -- green
    elseif ratio > 0.4 then
        return Color3.fromRGB(255, 200, 40) -- yellow
    else
        return Color3.fromRGB(255, 60, 60) -- red
    end
end

local function SetupDrawingTracer()
    -- Try to use Drawing library for line rendering (better performance)
    local ok, drawing = pcall(function()
        return Drawing.new("Line")
    end)
    if ok and drawing then
        ui.tracer = drawing
        ui.tracer.Thickness = 1.5
        ui.tracer.Transparency = 0.6
        ui.tracer.Visible = false
        return true
    end
    return false
end

local function CreateUI()
    if ui.gui then
        return
    end

    local gui = Instance.new("ScreenGui")
    gui.Name = "PrisonLifeAimDiagnostics"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 999
    gui.Parent = CoreGui
    ui.gui = gui

    -- FOV circle: Drawing.Circle overlay (primary, always renders on top),
    -- with a UI Frame fallback when the executor has no Drawing API.
    local circleOk, circle = pcall(function()
        return Drawing.new("Circle")
    end)
    if circleOk and typeof(circle) == "userdata" then
        circle.Thickness = 2
        circle.Color = Color3.fromRGB(255, 90, 90)
        circle.Transparency = 0
        circle.Visible = false
        circle.Radius = 100
        circle.Position = Vector2.new(0, 0)
        ui.fovCircle = circle
    else
        local fov = CreateFrame(gui, Color3.fromRGB(255, 90, 90), 0.75)
        fov.Name = "FOV"
        fov.BackgroundTransparency = 1
        fov.BorderSizePixel = 2
        fov.BorderColor3 = Color3.fromRGB(255, 90, 90)
        fov.Visible = false
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(1, 0)
        corner.Parent = fov
        ui.fov = fov
    end

    -- Target marker
    local marker = CreateFrame(gui, Color3.fromRGB(70, 255, 120), 0.05)
    marker.Name = "TargetMarker"
    marker.Size = UDim2.fromOffset(8, 8)
    marker.AnchorPoint = Vector2.new(0.5, 0.5)
    marker.Visible = false
    marker.ZIndex = 10
    local markerCorner = Instance.new("UICorner")
    markerCorner.CornerRadius = UDim.new(1, 0)
    markerCorner.Parent = marker
    ui.marker = marker

    -- Info label
    local label = Instance.new("TextLabel")
    label.Name = "TargetInfo"
    label.BackgroundTransparency = 1
    label.Size = UDim2.fromOffset(360, 26)
    label.AnchorPoint = Vector2.new(0.5, 0)
    label.Font = Enum.Font.Code
    label.TextSize = 14
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextStrokeTransparency = 0.25
    label.Visible = false
    label.Parent = gui
    ui.label = label

    -- Status bar
