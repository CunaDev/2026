-- Aim execution ----------------------------------------------------------------

-- Normal aim: MOUSE-POINTER lock (first- AND third-person).
-- Rotates the camera so the enemy stays exactly UNDER THE MOUSE CURSOR on
-- screen. When far from the cursor: Speed (fast convergence to acquire).
-- When close to the cursor: Smooth (gentle fine-tuning).
local function ExecuteNormalAim(candidate, camera, settings, deltaTime, radius)
    local targetPos = candidate.predictedPosition or candidate.part.Position
    local spread = settings.missSpread
    local distance = candidate.distance

    -- Apply miss spread by displacing the aim point in world space
    if spread > 0 then
        local dir = (targetPos - camera.CFrame.Position).Unit
        targetPos = camera.CFrame.Position + ApplyMissSpread(dir, spread, distance) * distance
    end

    local viewport = camera.ViewportSize
    if viewport.X <= 0 or viewport.Y <= 0 then
        return
    end

    -- Real 3D directions: toward the enemy, and through the mouse cursor
    local origin = camera.CFrame.Position
    local targetDir = (targetPos - origin).Unit
    local mousePos = GetMousePosition()
    local mouseRay = camera:ViewportPointToRay(mousePos.X, mousePos.Y)
    local mouseDir = mouseRay.Direction

    -- Express both directions in the camera's local space (right, up, forward)
    local right, up, look = camera.CFrame.RightVector, camera.CFrame.UpVector, camera.CFrame.LookVector
    local ltX, ltY, ltZ = targetDir:Dot(right), targetDir:Dot(up), targetDir:Dot(look)
    local lmX, lmY, lmZ = mouseDir:Dot(right), mouseDir:Dot(up), mouseDir:Dot(look)

    -- Angular gap between the mouse ray and the enemy ray
    local targetYaw = math.atan2(ltX, ltZ)
    local mouseYaw = math.atan2(lmX, lmZ)
    local targetPitch = math.atan2(ltY, math.sqrt(ltX * ltX + ltZ * ltZ))
    local mousePitch = math.atan2(lmY, math.sqrt(lmX * lmX + lmZ * lmZ))

    -- Correction angles (shortest path). Fixed point: enemy under the cursor.
    local yawOffset = WrapAngle(mouseYaw - targetYaw)
    local pitchOffset = WrapAngle(targetPitch - mousePitch)

    -- Angular distance (in radians) drives the speed/smooth transition
    local angDist = math.sqrt(yawOffset * yawOffset + pitchOffset * pitchOffset)
    local fovRad = math.rad(camera.FieldOfView)
    local threshold = (radius or 50) * 0.35 * (fovRad / math.max(viewport.Y, 1))

    local factor
    if angDist >= threshold then
        -- Speed: fast convergence, higher speed = faster
        local spd = Clamp(settings.aimSpeed, 0, 1)
        factor = spd >= 1 and 1 or (1 - math.exp(-spd * 14 * (deltaTime or 0.016)))
    else
        -- Smooth: gentle movement, higher smooth = smoother/slower
        local sm = Clamp(settings.smooth, 0, 10)
        local k = 40 / (sm + 1) -- smooth 0 → k=40 (snap), smooth 10 → k≈3.6 (gentle)
        factor = 1 - math.exp(-k * (deltaTime or 0.016))
    end
    factor = Clamp(factor, 0, 1)

    -- Rotate the camera by that fraction of the correction each frame.
    -- The correction is the exact angle between the mouse ray and the enemy
    -- ray, so it converges exactly when the enemy sits under the cursor and
    -- follows the cursor when the player moves the mouse while aiming.
    camera.CFrame = camera.CFrame * CFrame.Angles(pitchOffset * factor, yawOffset * factor, 0)
end

-- Silent aim: install metamethod hook on Raycast to redirect hits
local function InstallSilentHook()
    if silentHookInstalled then
        return
    end

    -- Silent aim requires the exploit's metamethod hooks; bail out if missing
    if type(hookmetamethod) ~= "function" or type(getnamecallmethod) ~= "function" then
        warn("[AimBot] Silent aim unavailable: hookmetamethod/getnamecallmethod not found")
        return
    end

    local success = pcall(function()
        local oldHook
        oldHook = hookmetamethod(game, "__namecall", function(self, ...)
            local method = getnamecallmethod()

            -- Intercept raycast calls when aiming is active
            if method == "Raycast" or method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRay" then
                if active and IsAimbotEnabled() and currentTarget then
                    -- Reuse the per-frame cached settings to avoid repeated flag reads
                    local settings = frameSettings or GetSettings()
                    local shouldAim = ShouldAim(settings)
                    if shouldAim and settings.aimMode == "Silent" then
                        local targetPos = currentTarget.predictedPosition or currentTarget.part.Position
                        local camera = GetCamera()
                        if camera then
                            local direction = (targetPos - camera.CFrame.Position).Unit
                            local spread = settings.missSpread
                            if spread > 0 then
                                direction = ApplyMissSpread(direction, spread, currentTarget.distance)
                            end

                            if method == "Raycast" then
                                local params = RaycastParams.new()
                                params.FilterType = Enum.RaycastFilterType.Blacklist
                                params.FilterDescendantsInstances = {
                                    GetCharacter(LocalPlayer),
                                    camera,
                                }
                                return Workspace:Raycast(
                                    camera.CFrame.Position,
                                    direction * (currentTarget.distance + 50),
                                    params
                                )
                            else
                                -- Legacy FindPartOnRay methods
                                local args = {...}
                                local newRay = Ray.new(camera.CFrame.Position, direction * 2000)
                                args[1] = newRay
                                return self[method](self, unpack(args))
                            end
                        end
                    end
                end
            end

            return self[method](self, ...)
        end)
    end)

    if success then
        silentHookInstalled = true
    end
end

-- Toggle key input handler
local function OnInputBegan(input, gameProcessed)
    if gameProcessed then
        return
    end
    if not active or not IsAimbotEnabled() then
        return
    end

    local settings = GetSettings()
    if settings.keyMode ~= "Toggle" then
        return
    end

    local key = settings.aimKey
    local matches = false

    if key == "Mouse Left" and input.UserInputType == Enum.UserInputType.MouseButton1 then
        matches = true
    elseif key == "Mouse Right" and input.UserInputType == Enum.UserInputType.MouseButton2 then
        matches = true
    elseif key == "Mouse Middle" and input.UserInputType == Enum.UserInputType.MouseButton3 then
        matches = true
    elseif key == "Keyboard" then
        local code = GetKeybindKey()
        if code and input.KeyCode == code then
            matches = true
        end
    end

    if matches then
        aimKeyToggled = not aimKeyToggled
    end
end

