--[[===========================================================================
    Prison Life — Aim Diagnostic Overlay
    ============================================================================

    Roblox Prison Life Custom Aimbot 모듈은 PRISONLIFE.lua에서 호출
    aimbot, Blatant slient 메인 로직 아직 구현 안됨
    
==============================================================================]]

local AimBot = {}

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

local function GetEnvironment()
    if type(getgenv) == "function" then
        return getgenv()
    end
    return _G
end

local Environment = GetEnvironment()

local DEFAULT_FLAGS = {
    aimbot_enabled = false,
    aimbot_Teamcheck = true,
    aimbot_Wallcheck = true,
    aimbot_fov = 5,
    aimbot_maxdist = 300,
    aimbot_hitbox = "head",
    aimbot_target_priority = "Smart",
    prisoner_execute_check = false,
    Blatantaimbot_enabled = false,
    Blatantaimbot_fov = 10,
    Blatantaimbot_maxdist = 1500,
    Blatantaimbot_teamcheck = true,
    Blatantaimbot_hitbox = "head",
}

local function GetFlag(name)
    local library = Environment.library
    local flags = library and library.flags
    local value = flags and flags[name]
    if value ~= nil then
        return value
    end
    return DEFAULT_FLAGS[name]
end

local function Clamp(value, minimum, maximum)
    return math.max(minimum, math.min(maximum, value))
end

local function GetCamera()
    return workspace.CurrentCamera
end

local function GetMousePosition()
    local ok, position = pcall(function()
        return UserInputService:GetMouseLocation()
    end)
    if ok and typeof(position) == "Vector2" then
        return position
    end
    local camera = GetCamera()
    if camera then
        local viewport = camera.ViewportSize
        return Vector2.new(viewport.X * 0.5, viewport.Y * 0.5)
    end
    return Vector2.new(0, 0)
end

local function GetCharacter(player)
    return player and player.Character
end

local function GetHumanoid(player)
    local character = GetCharacter(player)
    if not character then
        return nil
    end
    return character:FindFirstChildOfClass("Humanoid")
end

local function IsAlive(player)
    local humanoid = GetHumanoid(player)
    return humanoid and humanoid.Health > 0
end

local function IsEnemy(player)
    if not player or player == LocalPlayer then
        return false
    end
    if player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
        return false
    end
    if player.TeamColor and LocalPlayer.TeamColor and player.TeamColor == LocalPlayer.TeamColor then
        return false
    end
    return true
end

local HOSTILE_ATTRIBUTES = {
    "EquippedHostileTool",
    "Hostile",
    "PunchedSomeone",
  --"Trespassing",
}

local function HasHostileAttribute(player)
    local character = GetCharacter(player)
    if not character then
        return false
    end

    -- Prison Life player model attributes are authoritative for this check.
    -- Attribute value must be actual boolean true; truthy strings are ignored.
    for _, attributeName in ipairs(HOSTILE_ATTRIBUTES) do
        if character:GetAttribute(attributeName) == true then
            return true
        end
    end

    return false
end

local function CanExecute(player)
    if not GetFlag("prisoner_execute_check") then
        return true
    end

    -- 처형 규칙은 Guards가 Inmates를 대상으로 할 때만 적용.
    if not LocalPlayer.Team or LocalPlayer.Team.Name ~= "Guards" then
        return true
    end
    if not player.Team or player.Team.Name ~= "Inmates" then
        return true
    end

    return HasHostileAttribute(player)
end

local HITBOX_PARTS = {
    head = { "Head" },
    chest = { "HumanoidRootPart", "UpperTorso", "LowerTorso", "Torso" },
    legs = { "HumanoidRootPart", "RightUpperLeg", "LeftUpperLeg", "RightLowerLeg", "LeftLowerLeg" },
}

local function GetPart(player, hitbox)
    local character = GetCharacter(player)
    if not character then
        return nil
    end

    for _, name in ipairs(HITBOX_PARTS[hitbox] or HITBOX_PARTS.head) do
        local part = character:FindFirstChild(name)
        if part and part:IsA("BasePart") then
            return part
        end
    end

    return character:FindFirstChild("HumanoidRootPart")
        or character:FindFirstChild("Head")
end

local function IsVisible(camera, part)
    if not GetFlag("aimbot_Wallcheck") then
        return true
    end

    local character = GetCharacter(LocalPlayer)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { character, camera }

    local result = workspace:Raycast(camera.CFrame.Position, part.Position - camera.CFrame.Position, params)
    return not result or result.Instance:IsDescendantOf(part.Parent)
end

local function GetSettings()
    local blatant = GetFlag("Blatantaimbot_enabled") == true
    local fovValue = tonumber(GetFlag(blatant and "Blatantaimbot_fov" or "aimbot_fov")) or 5
    local maxDistance = tonumber(GetFlag(blatant and "Blatantaimbot_maxdist" or "aimbot_maxdist")) or 300
    local hitbox = tostring(GetFlag(blatant and "Blatantaimbot_hitbox" or "aimbot_hitbox"))
    local teamcheck = GetFlag(blatant and "Blatantaimbot_teamcheck" or "aimbot_Teamcheck")

    return {
        blatant = blatant,
        fov = Clamp(fovValue, 0, 10) / 10,
        maxDistance = math.max(maxDistance, 0),
        hitbox = hitbox,
        teamcheck = teamcheck,
    }
end

local function ScoreCandidate(candidate, settings, mousePosition, radius)
    local priority = tostring(GetFlag("aimbot_target_priority"))
    local health = candidate.humanoid.Health
    local maxHealth = math.max(candidate.humanoid.MaxHealth, 1)
    local distanceScore = candidate.distance / math.max(settings.maxDistance, 1)
    local pointScore = candidate.screenDistance / math.max(radius, 1)
    local healthScore = health / maxHealth

    if priority == "Point" then
        return candidate.screenDistance
    elseif priority == "Health" then
        return health
    elseif priority == "Distance" then
        return candidate.distance
    elseif priority == "Hurttime" then
        return -(candidate.hurtTime or 0)
    elseif priority == "Items" then
        return -(candidate.itemCount or 0) * 100 + candidate.distance * 0.001
    elseif priority == "Random" then
        return math.random()
    end

    -- Smart: 화면 근접도, 거리, 체력을 함께 고려한다.
    return pointScore * 0.40 + distanceScore * 0.35 + healthScore * 0.25
end

local function FindBestCandidate()
    local camera = GetCamera()
    if not camera then
        return nil, 0
    end

    local settings = GetSettings()
    local mousePosition = GetMousePosition()
    local radius = settings.fov * math.min(camera.ViewportSize.X, camera.ViewportSize.Y) * 0.5
    local origin = camera.CFrame.Position
    local candidates = {}

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and IsAlive(player) then
            if (not settings.teamcheck or IsEnemy(player)) and CanExecute(player) then
                local humanoid = GetHumanoid(player)
                local part = GetPart(player, settings.hitbox)
                if humanoid and part then
                    local distance = (part.Position - origin).Magnitude
                    local screenPoint, onScreen = camera:WorldToViewportPoint(part.Position)
                    local screenDistance = (Vector2.new(screenPoint.X, screenPoint.Y) - mousePosition).Magnitude

                    if onScreen and distance <= settings.maxDistance and screenDistance <= radius then
                        if IsVisible(camera, part) then
                            local itemCount = 0
                            for _, child in ipairs(GetCharacter(player):GetChildren()) do
                                if child:IsA("Tool") then
                                    itemCount = itemCount + 1
                                end
                            end

                            local candidate = {
                                player = player,
                                humanoid = humanoid,
                                part = part,
                                distance = distance,
                                screenPoint = Vector2.new(screenPoint.X, screenPoint.Y),
                                screenDistance = screenDistance,
                                itemCount = itemCount,
                            }
                            candidate.score = ScoreCandidate(candidate, settings, mousePosition, radius)
                            table.insert(candidates, candidate)
                        end
                    end
                end
            end
        end
    end

    if #candidates == 0 then
        return nil, radius
    end

    table.sort(candidates, function(left, right)
        return left.score < right.score
    end)

    return candidates[1], radius
end

-- UI ---------------------------------------------------------------------------
local ui = {
    gui = nil,
    fov = nil,
    marker = nil,
    label = nil,
    status = nil,
}

local function CreateFrame(parent, color, transparency)
    local frame = Instance.new("Frame")
    frame.BackgroundColor3 = color
    frame.BackgroundTransparency = transparency
    frame.BorderSizePixel = 0
    frame.Parent = parent
    return frame
end

local function CreateUI()
    if ui.gui then
        return
    end

    local gui = Instance.new("ScreenGui")
    gui.Name = "PrisonLifeAimDiagnostics"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 999
    gui.Parent = CoreGui
    ui.gui = gui

    local fov = CreateFrame(gui, Color3.fromRGB(255, 90, 90), 0.75)
    fov.Name = "FOV"
    fov.BackgroundTransparency = 1
    fov.BorderSizePixel = 2
    fov.Visible = false
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = fov
    ui.fov = fov

    local marker = CreateFrame(gui, Color3.fromRGB(70, 255, 120), 0.05)
    marker.Name = "TargetMarker"
    marker.Size = UDim2.fromOffset(8, 8)
    marker.AnchorPoint = Vector2.new(0.5, 0.5)
    marker.Visible = false
    local markerCorner = Instance.new("UICorner")
    markerCorner.CornerRadius = UDim.new(1, 0)
    markerCorner.Parent = marker
    ui.marker = marker

    local label = Instance.new("TextLabel")
    label.Name = "TargetInfo"
    label.BackgroundTransparency = 1
    label.Size = UDim2.fromOffset(360, 26)
    label.AnchorPoint = Vector2.new(0.5, 0)
    label.Font = Enum.Font.Code
    label.TextSize = 14
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextStrokeTransparency = 0.25
    label.Visible = false
    label.Parent = gui
    ui.label = label

    local status = Instance.new("TextLabel")
    status.Name = "DiagnosticStatus"
    status.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    status.BackgroundTransparency = 0.25
    status.BorderSizePixel = 0
    status.Position = UDim2.fromOffset(12, 12)
    status.Size = UDim2.fromOffset(360, 28)
    status.Font = Enum.Font.Code
    status.TextSize = 13
    status.TextXAlignment = Enum.TextXAlignment.Left
    status.TextColor3 = Color3.fromRGB(220, 220, 220)
    status.Parent = gui
    ui.status = status
end

local function HideUI()
    if ui.fov then ui.fov.Visible = false end
    if ui.marker then ui.marker.Visible = false end
    if ui.label then ui.label.Visible = false end
    if ui.status then ui.status.Text = "AIM DIAGNOSTICS  |  OFF" end
end

local function UpdateUI(candidate, radius)
    local camera = GetCamera()
    if not camera or not ui.gui then
        return
    end

    local mousePosition = GetMousePosition()
    local diameter = radius * 2
    ui.fov.Position = UDim2.fromOffset(mousePosition.X - radius, mousePosition.Y - radius)
    ui.fov.Size = UDim2.fromOffset(diameter, diameter)
    ui.fov.Visible = GetFlag("aimbot_enabled") == true

    if not candidate then
        ui.marker.Visible = false
        ui.label.Visible = false
        ui.status.Text = "AIM DIAGNOSTICS  |  NO CANDIDATE"
        return
    end

    local point = candidate.screenPoint
    ui.marker.Position = UDim2.fromOffset(point.X, point.Y)
    ui.marker.BackgroundColor3 = GetSettings().blatant
        and Color3.fromRGB(255, 200, 40)
        or Color3.fromRGB(70, 255, 120)
    ui.marker.Visible = true

    ui.label.Position = UDim2.fromOffset(point.X, point.Y + 12)
    ui.label.Text = string.format(
        "%s | %s | %.0f studs | HP %.0f | %s",
        candidate.player.DisplayName,
        candidate.player.Team and candidate.player.Team.Name or "NoTeam",
        candidate.distance,
        candidate.humanoid.Health,
        tostring(GetFlag("aimbot_target_priority"))
    )
    ui.label.Visible = true
    ui.status.Text = "AIM DIAGNOSTICS  |  TARGET CANDIDATE"
end

-- 라이프사이클 -------------------------------------------------------------------
local connection = nil
local active = false
local errorReported = false

function AimBot.Start()
    if active then
        return
    end

    active = true
    errorReported = false
    CreateUI()

    connection = RunService.RenderStepped:Connect(function()
        if not active then
            return
        end

        local ok, err = xpcall(function()
            if GetFlag("aimbot_enabled") ~= true then
                HideUI()
                return
            end

            local candidate, radius = FindBestCandidate()
            UpdateUI(candidate, radius)
        end, debug.traceback)

        if not ok and not errorReported then
            errorReported = true
            warn("[AimDiagnostics] update failed: " .. tostring(err))
        end
    end)
end

function AimBot.Stop()
    active = false

    if connection then
        connection:Disconnect()
        connection = nil
    end

    HideUI()

    if ui.gui then
        ui.gui:Destroy()
        ui.gui = nil
        ui.fov = nil
        ui.marker = nil
        ui.label = nil
        ui.status = nil
    end
end

return AimBot
