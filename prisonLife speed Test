local SpeedBypass = {}

local State = {
	Enabled           = false,
	CurrentSpeed      = 16,
	BodyVelocity      = nil,     -- HumanoidRootPart 에 부착
	Character         = nil,
	Humanoid          = nil,
	Root              = nil,
	RunAnim           = nil,
	ConnCharacterAdded = nil,
	ConnHeartbeat       = nil,
}

local SPEED_MIN   = 0
local SPEED_MAX   = 500
local RUN_ANIM_ID = "rbxassetid://180435571" -- R6/R15 공용

local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer

-- ------------------------------------------------------------------
-- 디버그
-- ------------------------------------------------------------------
local DEBUG = true
local function Log(msg)
	if DEBUG then
		print("[SpeedBypass] " .. msg)
	end
end

local function SafeCall(fn, ...)
	local ok, result = pcall(fn, ...)
	if not ok then
		Log("pcall 실패: " .. tostring(result))
		return nil
	end
	return result
end

local function Clamp(value, min, max)
	return math.max(min, math.min(max, value))
end

-- ------------------------------------------------------------------
-- 달리기 애니메이션 (R6 호환)
-- ------------------------------------------------------------------
local function PlayRunAnimation()
	SafeCall(function()
		local humanoid = State.Humanoid
		if not humanoid then return end

		-- Humanoid 상태를 Running 으로 강제 전환
		-- (R6 는 Animator 가 없을 수 있음)
		if humanoid:GetState() ~= Enum.HumanoidStateType.Running then
			humanoid:ChangeState(Enum.HumanoidStateType.Running)
		end

		-- Animator 가 있으면 달리기 애니메이션 재생
		local animator = humanoid:FindFirstChildOfClass("Animator")
		if not animator then return end
		if State.RunAnim and State.RunAnim.IsPlaying then return end

		local anim = Instance.new("Animation")
		anim.AnimationId = RUN_ANIM_ID
		local track = animator:LoadAnimation(anim)
		track.Priority = Enum.AnimationPriority.Movement
		track.Looped = true
		track:Play()
		track:AdjustSpeed(1)
		State.RunAnim = track
		Log("달리기 애니메이션 재생 시작")
	end)
end

local function StopRunAnimation()
	if State.RunAnim then
		SafeCall(function() State.RunAnim:Stop() end)
		SafeCall(function() State.RunAnim:Destroy() end)
	end
	State.RunAnim = nil
end

-- ------------------------------------------------------------------
-- BodyVelocity 생성/제거
-- ------------------------------------------------------------------
local function CreateBodyVelocity(root)
	-- 기존 인스턴스 제거
	local existing = root:FindFirstChild("SpeedBypassVelocity")
	if existing then
		existing:Destroy()
	end

	local bv = Instance.new("BodyVelocity")
	bv.Name = "SpeedBypassVelocity"
	bv.MaxForce = Vector3.new(100000, 0, 100000)  -- Y 축은 중력
	bv.Velocity = Vector3.zero
	bv.P = 10000
	bv.Parent = root
	Log("BodyVelocity 생성됨, Parent=" .. root.Name)
	return bv
end

local function RemoveBodyVelocity()
	if State.BodyVelocity then
		SafeCall(function() State.BodyVelocity:Destroy() end)
	end
	State.BodyVelocity = nil
	Log("BodyVelocity 제거됨")
end

-- ------------------------------------------------------------------
-- 적용
-- ------------------------------------------------------------------
local function ApplySpeed()
	local root = State.Root
	local humanoid = State.Humanoid
	if not root or not humanoid then
		Log("ApplySpeed 중단: root/humanoid 없음")
		return
	end

	RemoveBodyVelocity()

	local bv = SafeCall(function()
		return CreateBodyVelocity(root)
	end)
	if not bv then
		Log("ApplySpeed 중단: BodyVelocity 생성 실패")
		return
	end

	State.BodyVelocity = bv
	Log("ApplySpeed 완료")
end

-- ------------------------------------------------------------------
-- 입력 방향 (WASD + 카메라 기준)
-- ------------------------------------------------------------------
local function GetInputDirection()
	local camera = workspace.CurrentCamera
	local cf = camera and camera.CFrame or CFrame.new()

	local flatLook = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
	local flatRight = Vector3.new(cf.RightVector.X, 0, cf.RightVector.Z)
	if flatLook.Magnitude > 0.001 then flatLook = flatLook.Unit end
	if flatRight.Magnitude > 0.001 then flatRight = flatRight.Unit end

	local dir = Vector3.zero
	if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += flatLook end
	if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= flatLook end
	if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += flatRight end
	if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= flatRight end
	if dir.Magnitude > 0.001 then dir = dir.Unit end
	return dir
end

-- ------------------------------------------------------------------
-- Heartbeat
-- ------------------------------------------------------------------
local function OnHeartbeat()
	if not State.Enabled then return end

	local root = State.Root
	local humanoid = State.Humanoid
	local bv = State.BodyVelocity
	if not root or not humanoid or not bv or not bv.Parent then
		-- BodyVelocity 소실 → 재생성
		Log("Heartbeat: BodyVelocity 유실, 재생성")
		ApplySpeed()
		return
	end

	-- 입력 방향으로 속도 설정
	SafeCall(function()
		local dir = GetInputDirection()
		if dir.Magnitude > 0.01 then
			bv.Velocity = dir * State.CurrentSpeed
		else
			bv.Velocity = Vector3.new(0, bv.Velocity.Y, 0)
		end
	end)

	-- 달리기 애니메이션 (R6 호환)
	PlayRunAnimation()
end

-- ------------------------------------------------------------------
-- 리스폰
-- ------------------------------------------------------------------
local function OnCharacterAdded(character)
	State.Character = character
	State.Humanoid = SafeCall(function() return character:WaitForChild("Humanoid", 5) end)
	State.Root = SafeCall(function() return character:WaitForChild("HumanoidRootPart", 5) end)
	Log("CharacterAdded: " .. tostring(character.Name))

	RemoveBodyVelocity()
	StopRunAnimation()

	if State.Enabled then
		task.spawn(function()
			task.wait(0.5)
			if State.Enabled then
				ApplySpeed()
			end
		end)
	end
end

-- ------------------------------------------------------------------
-- 공개 인터페이스
-- ------------------------------------------------------------------
function SpeedBypass.Toggle(desired)
	if desired == nil then desired = not State.Enabled end
	Log("Toggle(" .. tostring(desired) .. ")")

	SafeCall(function()
		if desired then
			State.Enabled = true
			ApplySpeed()
			PlayRunAnimation()
			Log("활성화 완료 — 속도=" .. State.CurrentSpeed)
		else
			State.Enabled = false
			RemoveBodyVelocity()
			StopRunAnimation()
			Log("비활성화 완료")
		end
	end)

	return State.Enabled
end

function SpeedBypass.SetSpeed(value)
	local clamped = Clamp(value, SPEED_MIN, SPEED_MAX)
	State.CurrentSpeed = clamped
	Log("SetSpeed(" .. tostring(value) .. ") → " .. tostring(clamped))
	return clamped
end

function SpeedBypass.GetStatus()
	return {
		Enabled        = State.Enabled,
		CurrentSpeed   = State.CurrentSpeed,
		BVActive       = State.BodyVelocity ~= nil and State.BodyVelocity.Parent ~= nil,
		CharacterAlive = State.Character ~= nil and State.Character.Parent ~= nil,
	}
end

function SpeedBypass.Destroy()
	State.Enabled = false
	RemoveBodyVelocity()
	StopRunAnimation()
	if State.ConnCharacterAdded then State.ConnCharacterAdded:Disconnect() end
	if State.ConnHeartbeat then State.ConnHeartbeat:Disconnect() end
	State.ConnCharacterAdded = nil
	State.ConnHeartbeat = nil
	Log("Destroy 완료")
end

-- ------------------------------------------------------------------
-- 부팅
-- ------------------------------------------------------------------
task.spawn(function()
	State.ConnCharacterAdded = LocalPlayer.CharacterAdded:Connect(OnCharacterAdded)
	if LocalPlayer.Character then
		OnCharacterAdded(LocalPlayer.Character)
	end
	State.ConnHeartbeat = RunService.Heartbeat:Connect(OnHeartbeat)
	Log("SpeedBypass 모듈 부팅 완료")
end)

getgenv().SpeedBypass = SpeedBypass
return SpeedBypass
