local SpeedBypass = {}

-- ------------------------------------------------------------------
-- 내부 상태
-- ------------------------------------------------------------------
local State = {
	Enabled           = false,   -- 마스터 토글
	CurrentSpeed      = 16,      -- 활성화 시 목표 속도 (VehicleSeat MaxSpeed)
	Seat              = nil,     -- 투명 VehicleSeat 인스턴스
	Character         = nil,     -- 현재(로컬) 캐릭터
	Humanoid          = nil,     -- 현재 휴머노이드
	ConnCharacterAdded = nil,    -- CharacterAdded 연결
	ConnHeartbeat       = nil,    -- Heartbeat 연결
}

local SPEED_MIN   = 0
local SPEED_MAX   = 500

local Players     = game:GetService("Players")
local RunService  = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

-- ------------------------------------------------------------------
-- 안전 래퍼
-- ------------------------------------------------------------------
local function SafeCall(fn, ...)
	local ok, result = pcall(fn, ...)
	if not ok then
		warn("[SpeedBypass] pcall 가드 발동:", result)
		return nil
	end
	return result
end

local function Clamp(value, min, max)
	return math.max(min, math.min(max, value))
end

-- ------------------------------------------------------------------
-- VehicleSeat 생성
-- ------------------------------------------------------------------
local function CreateSeat(parent)
	local seat = Instance.new("VehicleSeat")
	seat.Name = "SpeedBypassSeat"
	seat.Transparency = 1
	seat.Size = Vector3.new(2, 0.2, 2)
	seat.Anchored = false
	seat.CanCollide = false
	seat.CanTouch = false
	seat.MaxSpeed = State.CurrentSpeed
	seat.Throttle = 1    -- 자동 전진
	seat.Steer = 0
	seat.Parent = parent
	return seat
end

local function RemoveSeat()
	if State.Seat then
		SafeCall(function()
			State.Seat:Destroy()
		end)
	end
	State.Seat = nil
end

-- ------------------------------------------------------------------
-- 적용: VehicleSeat 생성 후 플레이어 앉히기
-- ------------------------------------------------------------------
local function ApplySeat()
	local char   = State.Character
	local humanoid = State.Humanoid
	if not char or not humanoid then
		return
	end

	local root = SafeCall(function()
		return char:FindFirstChild("HumanoidRootPart")
	end)
	if not root then
		return
	end

	RemoveSeat()

	local seat = SafeCall(function()
		local s = CreateSeat(char)
		-- 캐릭터 발밑에 배치
		s.CFrame = root.CFrame * CFrame.new(0, -3, 0)
		return s
	end)
	if not seat then
		return
	end

	State.Seat = seat

	-- 앉히기: Sit=true 로 가장 가까운 Seat/VehicleSeat 탐색
	SafeCall(function()
		humanoid.Sit = true
		task.wait(0.15)
		-- 이미 앉았으면 불필요한 Sit=false 는 생략
	end)
end

-- ------------------------------------------------------------------
-- Heartbeat 드라이버
-- ------------------------------------------------------------------
local function OnHeartbeat()
	if not State.Enabled then
		return
	end

	local char   = State.Character
	local humanoid = State.Humanoid
	if not char or not humanoid or not char.Parent then
		return
	end

	-- VehicleSeat 이 사라졌으면 재생성
	if not State.Seat or not State.Seat.Parent then
		SafeCall(ApplySeat)
		return
	end

	-- VehicleSeat MaxSpeed 업데이트 (WalkSpeed 는 건드리지 않음)
	SafeCall(function()
		State.Seat.MaxSpeed = State.CurrentSpeed
		State.Seat.Throttle = 1
	end)

	-- 클라이언트 측 HumanoidState 를 Running 으로 강제 전환
	-- 서버는 여전히 Seated 로 봄 → 애니메이션만 걷는 걸로 보임
	SafeCall(function()
		if humanoid:GetState() == Enum.HumanoidStateType.Seated then
			humanoid:ChangeState(Enum.HumanoidStateType.Running)
		end
	end)
end

-- ------------------------------------------------------------------
-- 리스폰 처리
-- ------------------------------------------------------------------
local function OnCharacterAdded(character)
	State.Character = character
	State.Humanoid = SafeCall(function()
		return character:WaitForChild("Humanoid", 5)
	end)

	RemoveSeat()

	if State.Enabled then
		task.spawn(function()
			task.wait(0.8)   -- 리그가 안정된 후 다시 앉히기
			if State.Enabled then
				SafeCall(ApplySeat)
			end
		end)
	end
end

-- ------------------------------------------------------------------
-- 공개 인터페이스
-- ------------------------------------------------------------------
function SpeedBypass.Toggle(desired)
	if desired == nil then
		desired = not State.Enabled
	end

	local ok = SafeCall(function()
		if desired then
			State.Enabled = true
			ApplySeat()
		else
			State.Enabled = false
			RemoveSeat()
			-- WalkSpeed 원복 (안전장치)
			if State.Humanoid then
				State.Humanoid.WalkSpeed = 16
			end
		end
	end)

	if ok == nil then
		State.Enabled = false
	end

	return State.Enabled
end

function SpeedBypass.SetSpeed(value)
	local clamped = Clamp(value, SPEED_MIN, SPEED_MAX)
	State.CurrentSpeed = clamped
	-- Heartbeat 이 MaxSpeed 에 반영함
	return clamped
end

function SpeedBypass.GetStatus()
	return {
		Enabled        = State.Enabled,
		CurrentSpeed   = State.CurrentSpeed,
		SeatActive     = State.Seat ~= nil and State.Seat.Parent ~= nil,
		CharacterAlive = State.Character ~= nil and State.Character.Parent ~= nil,
	}
end

function SpeedBypass.Destroy()
	State.Enabled = false
	RemoveSeat()

	if State.ConnCharacterAdded then
		State.ConnCharacterAdded:Disconnect()
	end
	if State.ConnHeartbeat then
		State.ConnHeartbeat:Disconnect()
	end
	State.ConnCharacterAdded = nil
	State.ConnHeartbeat = nil

	if State.Humanoid then
		SafeCall(function()
			State.Humanoid.WalkSpeed = 16
		end)
	end
end

-- ------------------------------------------------------------------
-- 부팅
-- ------------------------------------------------------------------
task.spawn(function()
	State.ConnCharacterAdded = LocalPlayer.CharacterAdded:Connect(OnCharacterAdded)
	if LocalPlayer.Character then
		OnCharacterAdded(LocalPlayer.Character)
	end
	State.ConnHeartbeat = RunService.Heartbeat:Connect(OnHeartbeat)
end)

getgenv().SpeedBypass = SpeedBypass
return SpeedBypass
