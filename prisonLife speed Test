--[[
	모듈   : speedBipassLOL.lua
	프로젝트 : PRISONLIFE — Roblox Prison Life 허브
	목적   : 투명 VehicleSeat 기반 속도 우회 — WalkSpeed 무수정

	원리
		workspace 에 투명 VehicleSeat 를 생성, 플레이어를 앉힌다.
		서버는 "탑승 중" 으로 인식 → WalkSpeed 검사 대상에서 제외.
		이동은 VehicleSeat.AssemblyLinearVelocity 를 WASD 방향으로
		가해 추진한다. Humanoid.WalkSpeed 는 절대 건드리지 않는다.

		좌석은 매 프레임 캐릭터 발밑으로 CFrame 을 따라붙게 한다.
		클라이언트 표시는 달리기 애니메이션으로 앉은 자세를 덮는다.

	인터페이스 (전역 `SpeedBypass`, 반환값으로도 사용 가능)
		SpeedBypass.Toggle(boolean?) -> boolean
		SpeedBypass.SetSpeed(number) -> number
		SpeedBypass.GetStatus()      -> table
		SpeedBypass.Destroy()        -> nil
--]]

local SpeedBypass = {}

local State = {
	Enabled           = false,
	CurrentSpeed      = 16,
	Seat              = nil,     -- workspace 의 투명 VehicleSeat
	Character         = nil,
	Humanoid          = nil,
	Root              = nil,
	RunAnim           = nil,
	ConnCharacterAdded = nil,
	ConnHeartbeat       = nil,
}

local SPEED_MIN   = 0
local SPEED_MAX   = 500
local SEAT_OFFSET = CFrame.new(0, -2, 0)      -- 발밑 배치
local RUN_ANIM_ID = "rbxassetid://180435571"  -- R15 달리기 애니메이션

local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer

-- ------------------------------------------------------------------
-- 디버그
-- ------------------------------------------------------------------
local DEBUG = true
local function Log(msg)
	if DEBUG then
		print("[SpeedBypass] " .. msg)
	end
end

local function SafeCall(fn, ...)
	local ok, result = pcall(fn, ...)
	if not ok then
		Log("pcall 실패: " .. tostring(result))
		return nil
	end
	return result
end

local function Clamp(value, min, max)
	return math.max(min, math.min(max, value))
end

-- ------------------------------------------------------------------
-- 달리기 애니메이션 (앉은 자세 덮기)
-- ------------------------------------------------------------------
local function PlayRunAnimation()
	SafeCall(function()
		local humanoid = State.Humanoid
		if not humanoid then return end
		local animator = humanoid:FindFirstChildOfClass("Animator")
		if not animator then return end
		if State.RunAnim and State.RunAnim.IsPlaying then return end

		local anim = Instance.new("Animation")
		anim.AnimationId = RUN_ANIM_ID
		local track = animator:LoadAnimation(anim)
		track.Priority = Enum.AnimationPriority.Action
		track.Looped = true
		track:Play()
		track:AdjustSpeed(1)
		State.RunAnim = track
	end)
end

local function StopRunAnimation()
	if State.RunAnim then
		SafeCall(function() State.RunAnim:Stop() end)
		SafeCall(function() State.RunAnim:Destroy() end)
	end
	State.RunAnim = nil
end

-- ------------------------------------------------------------------
-- VehicleSeat 생성/제거
-- ------------------------------------------------------------------
local function CreateSeat(root)
	local seat = Instance.new("VehicleSeat")
	seat.Name = "SpeedBypassSeat"
	seat.Transparency = 1
	seat.Size = Vector3.new(2, 0.2, 2)
	seat.CanCollide = false
	seat.CanTouch = false
	seat.MaxSpeed = State.CurrentSpeed
	seat.Parent = workspace
	seat.CFrame = root.CFrame * SEAT_OFFSET
	Log("VehicleSeat 생성됨, MaxSpeed=" .. State.CurrentSpeed)
	return seat
end

local function RemoveSeat()
	if State.Seat then
		SafeCall(function() State.Seat:Destroy() end)
	end
	State.Seat = nil
	Log("VehicleSeat 제거됨")
end

-- ------------------------------------------------------------------
-- 앉히기
-- ------------------------------------------------------------------
local function SitPlayer()
	local humanoid = State.Humanoid
	local seat = State.Seat
	if not humanoid or not seat then return end

	SafeCall(function()
		for i = 1, 5 do
			humanoid.Sit = true
			task.wait(0.15)
			Log("앉기 시도 " .. i .. "회 — Occupant=" .. tostring(seat.Occupant))
			if seat.Occupant == humanoid then
				Log("앉기 성공!")
				return
			end
		end
		Log("앉기 실패: 5회 모두 실패")
	end)
end

-- ------------------------------------------------------------------
-- 적용
-- ------------------------------------------------------------------
local function ApplySeat()
	local char = State.Character
	local humanoid = State.Humanoid
	local root = State.Root
	Log("ApplySeat 호출")

	if not char or not humanoid or not root then
		Log("ApplySeat 중단: char/humanoid/root 없음")
		return
	end

	RemoveSeat()

	local seat = SafeCall(function()
		return CreateSeat(root)
	end)
	if not seat then
		Log("ApplySeat 중단: seat 생성 실패")
		return
	end

	State.Seat = seat
	SitPlayer()
end

-- ------------------------------------------------------------------
-- 입력 방향
-- ------------------------------------------------------------------
local function GetInputDirection()
	local camera = workspace.CurrentCamera
	local cf = camera and camera.CFrame or CFrame.new()

	local flatLook = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
	local flatRight = Vector3.new(cf.RightVector.X, 0, cf.RightVector.Z)
	if flatLook.Magnitude > 0.001 then flatLook = flatLook.Unit end
	if flatRight.Magnitude > 0.001 then flatRight = flatRight.Unit end

	local dir = Vector3.zero
	if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += flatLook end
	if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= flatLook end
	if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += flatRight end
	if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= flatRight end
	if dir.Magnitude > 0.001 then dir = dir.Unit end
	return dir
end

-- ------------------------------------------------------------------
-- Heartbeat
-- ------------------------------------------------------------------
local function OnHeartbeat()
	if not State.Enabled then return end

	local char = State.Character
	local humanoid = State.Humanoid
	local root = State.Root
	if not char or not humanoid or not root or not char.Parent then return end

	-- 좌석 유실 시 재생성
	if not State.Seat or not State.Seat.Parent then
		Log("Heartbeat: 좌석 유실, 재생성")
		ApplySeat()
		return
	end

	local seat = State.Seat

	-- 좌석을 캐릭터 발밑으로 따라붙게 (용접 없이 CFrame 동기화)
	SafeCall(function()
		seat.CFrame = root.CFrame * SEAT_OFFSET
	end)

	-- 이동: WASD 방향으로 속도 적용 (WalkSpeed 무수정)
	SafeCall(function()
		local dir = GetInputDirection()
		if dir.Magnitude > 0.01 then
			seat.AssemblyLinearVelocity = dir * State.CurrentSpeed
		else
			seat.AssemblyLinearVelocity = Vector3.new(0, seat.AssemblyLinearVelocity.Y, 0)
		end
	end)

	-- 클라이언트 표시: 달리기 애니메이션으로 앉은 자세 덮기
	PlayRunAnimation()
end

-- ------------------------------------------------------------------
-- 리스폰
-- ------------------------------------------------------------------
local function OnCharacterAdded(character)
	State.Character = character
	State.Humanoid = SafeCall(function() return character:WaitForChild("Humanoid", 5) end)
	State.Root = SafeCall(function() return character:WaitForChild("HumanoidRootPart", 5) end)

	RemoveSeat()
	StopRunAnimation()

	if State.Enabled then
		task.spawn(function()
			task.wait(0.8)
			if State.Enabled then
				ApplySeat()
			end
		end)
	end
end

-- ------------------------------------------------------------------
-- 공개 인터페이스
-- ------------------------------------------------------------------
function SpeedBypass.Toggle(desired)
	if desired == nil then desired = not State.Enabled end
	Log("Toggle(" .. tostring(desired) .. ") — 현재 Enabled=" .. tostring(State.Enabled))

	SafeCall(function()
		if desired then
			State.Enabled = true
			ApplySeat()
			PlayRunAnimation()
			Log("활성화 완료")
		else
			State.Enabled = false
			RemoveSeat()
			StopRunAnimation()
			Log("비활성화 완료")
		end
	end)

	if not State.Enabled and desired then
		Log("Toggle: pcall 실패로 강제 비활성화")
	end

	return State.Enabled
end

function SpeedBypass.SetSpeed(value)
	local clamped = Clamp(value, SPEED_MIN, SPEED_MAX)
	State.CurrentSpeed = clamped
	Log("SetSpeed(" .. tostring(value) .. ") → " .. tostring(clamped))
	if State.Seat and State.Seat.Parent then
		SafeCall(function()
			State.Seat.MaxSpeed = clamped
		end)
	end
	return clamped
end

function SpeedBypass.GetStatus()
	return {
		Enabled        = State.Enabled,
		CurrentSpeed   = State.CurrentSpeed,
		SeatActive     = State.Seat ~= nil and State.Seat.Parent ~= nil,
		CharacterAlive = State.Character ~= nil and State.Character.Parent ~= nil,
	}
end

function SpeedBypass.Destroy()
	State.Enabled = false
	RemoveSeat()
	StopRunAnimation()
	if State.ConnCharacterAdded then State.ConnCharacterAdded:Disconnect() end
	if State.ConnHeartbeat then State.ConnHeartbeat:Disconnect() end
	State.ConnCharacterAdded = nil
	State.ConnHeartbeat = nil
end

-- ------------------------------------------------------------------
-- 부팅
-- ------------------------------------------------------------------
task.spawn(function()
	State.ConnCharacterAdded = LocalPlayer.CharacterAdded:Connect(OnCharacterAdded)
	if LocalPlayer.Character then
		OnCharacterAdded(LocalPlayer.Character)
	end
	State.ConnHeartbeat = RunService.Heartbeat:Connect(OnHeartbeat)
	Log("부팅 완료 — SpeedBypass 모듈 로드됨")
end)

getgenv().SpeedBypass = SpeedBypass
return SpeedBypass
