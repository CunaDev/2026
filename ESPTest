-- ESP Module - Blissful Design (Fixed Positioning)
-- Quad-based box, vertical health bar, proper Team Check
-- Module API: { Start(), Stop(), ESP = { ... } }

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local GuiService = game:GetService("GuiService")
local LocalPlayer = Players.LocalPlayer
local mouse = LocalPlayer:GetMouse()

local ESP = {
    State = false,
    Boxes = true,
    Tracers = true,
    Names = true,
    Distance = false,
    Health = true,
    TeamCheck = false,
    TeamColor = true,
    MaxDistance = 500,
    BoxColor = Color3.fromRGB(255, 0, 0),
    TracerColor = Color3.fromRGB(255, 0, 0),
    BoxThickness = 1,
    TracerThickness = 1,
    TracerOrigin = "Bottom",
    TracerFollowMouse = false,
}

local ESP_UI = {}
local ESP_Connections = {}
local ESP_Render

local function NewQuad(thickness, color)
    local q = Drawing.new("Quad")
    q.Visible = false
    q.PointA = Vector2.new(0, 0)
    q.PointB = Vector2.new(0, 0)
    q.PointC = Vector2.new(0, 0)
    q.PointD = Vector2.new(0, 0)
    q.Color = color
    q.Filled = false
    q.Thickness = thickness
    q.Transparency = 1
    return q
end

local function NewLine(thickness, color)
    local l = Drawing.new("Line")
    l.Visible = false
    l.From = Vector2.new(0, 0)
    l.To = Vector2.new(0, 0)
    l.Color = color
    l.Thickness = thickness
    l.Transparency = 1
    return l
end

local function MakeUI()
    return {
        blacktracer = NewLine(2, Color3.fromRGB(0, 0, 0)),
        tracer = NewLine(1, ESP.TracerColor),
        black = NewQuad(2, Color3.fromRGB(0, 0, 0)),
        box = NewQuad(1, ESP.BoxColor),
        healthbar = NewLine(3, Color3.fromRGB(0, 0, 0)),
        greenhealth = NewLine(1.5, Color3.fromRGB(0, 0, 0)),
        name = Drawing.new("Text"),
        dist = Drawing.new("Text"),
    }
end

local function SetupUI(ui)
    ui.name.Center = true
    ui.name.Outline = true
    ui.name.Size = 13
    ui.name.Visible = false
    ui.dist.Center = true
    ui.dist.Outline = true
    ui.dist.Size = 12
    ui.dist.Visible = false
end

local function Colorize(lib, color)
    for _, x in pairs(lib) do
        if x ~= lib.healthbar and x ~= lib.greenhealth and x ~= lib.blacktracer and x ~= lib.black then
            x.Color = color
        end
    end
end

local function GetHeadFootScreen(char, camera)
    local head = char:FindFirstChild("Head")
    local root = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
    if not head or not root then return nil, nil end

    local headPos, headOn = camera:WorldToViewportPoint(head.Position)
    local rootPos, rootOn = camera:WorldToViewportPoint(root.Position)
    if not headOn or not rootOn then return nil, nil end

    local distY = math.clamp(math.abs(headPos.Y - rootPos.Y), 2, math.huge)

    return headPos, rootPos, distY
end

local function BoxSize(ui, cx, cy, halfW, topOff, botOff)
    ui.black.PointA = Vector2.new(cx + halfW + 1, cy - topOff - 1)
    ui.black.PointB = Vector2.new(cx - halfW - 1, cy - topOff - 1)
    ui.black.PointC = Vector2.new(cx - halfW - 1, cy + botOff + 1)
    ui.black.PointD = Vector2.new(cx + halfW + 1, cy + botOff + 1)

    ui.box.PointA = Vector2.new(cx + halfW, cy - topOff)
    ui.box.PointB = Vector2.new(cx - halfW, cy - topOff)
    ui.box.PointC = Vector2.new(cx - halfW, cy + botOff)
    ui.box.PointD = Vector2.new(cx + halfW, cy + botOff)
end

local function GetColor(plr)
    if ESP.TeamCheck then
        if plr.TeamColor == LocalPlayer.TeamColor then
            return Color3.fromRGB(0, 255, 0)
        else
            return Color3.fromRGB(255, 0, 0)
        end
    end
    if ESP.TeamColor then
        return plr.TeamColor.Color
    end
    return ESP.BoxColor
end

local function Register(plr)
    if plr == LocalPlayer then return end
    local ui = MakeUI()
    SetupUI(ui)
    ESP_UI[plr] = ui
end

local function Unregister(plr)
    local ui = ESP_UI[plr]
    if ui then
        for _, d in pairs(ui) do
            pcall(d.Remove, d)
        end
        ESP_UI[plr] = nil
    end
end

local function Start()
    if ESP.State then return end
    ESP.State = true

    for _, plr in ipairs(Players:GetPlayers()) do
        Register(plr)
    end

    table.insert(ESP_Connections, Players.PlayerAdded:Connect(Register))
    table.insert(ESP_Connections, Players.PlayerRemoving:Connect(Unregister))

    ESP_Render = RunService.RenderStepped:Connect(function()
        local camera = workspace.CurrentCamera
        if not camera then return end
        local viewport = camera.ViewportSize
        local inset = GuiService:GetGuiInset()

        for plr, ui in pairs(ESP_UI) do
            local char = plr.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not char or not hum or hum.Health <= 0 then
                for _, d in pairs(ui) do d.Visible = false end
                continue
            end

            local root = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
            if not root then
                for _, d in pairs(ui) do d.Visible = false end
                continue
            end

            local headPos, rootPos, distY = GetHeadFootScreen(char, camera)
            if not headPos then
                for _, d in pairs(ui) do d.Visible = false end
                continue
            end

            local dist = (root.Position - camera.CFrame.Position).Magnitude
            if dist > ESP.MaxDistance then
                for _, d in pairs(ui) do d.Visible = false end
                continue
            end

            -- Box: head to roughly feet
            -- topOffset = head Y relative to root
            -- bottomOffset = estimated feet Y relative to root
            local topOff = (rootPos.Y - headPos.Y) * 1.2
            local botOff = distY * 0.9
            local halfW = distY * 0.65

            local color = GetColor(plr)
            local boxThick = ESP.BoxThickness
            local tracerThick = ESP.TracerThickness

            -- Update drawing thicknesses
            ui.black.Thickness = boxThick + 2
            ui.box.Thickness = boxThick
            ui.blacktracer.Thickness = tracerThick + 2
            ui.tracer.Thickness = tracerThick

            -- Box
            if ESP.Boxes then
                BoxSize(ui, rootPos.X, rootPos.Y, halfW, topOff, botOff)
                ui.box.Color = color
                ui.black.Visible = true
                ui.box.Visible = true
            else
                ui.black.Visible = false
                ui.box.Visible = false
            end

            -- Health bar (vertical, left of box)
            if ESP.Health then
                local d = distY * 2.1
                local hpRatio = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                local healthOffset = hpRatio * d

                local barX = rootPos.X - halfW - 5
                local barTop = rootPos.Y - topOff
                local barBot = rootPos.Y + botOff

                ui.healthbar.From = Vector2.new(barX, barBot)
                ui.healthbar.To = Vector2.new(barX, barTop)

                ui.greenhealth.From = Vector2.new(barX, barBot)
                ui.greenhealth.To = Vector2.new(barX, barBot - healthOffset)
                ui.greenhealth.Color = Color3.fromRGB(0, 255, 0):lerp(
                    Color3.fromRGB(255, 0, 0), 1 - hpRatio)

                ui.healthbar.Visible = true
                ui.greenhealth.Visible = true
            else
                ui.healthbar.Visible = false
                ui.greenhealth.Visible = false
            end

            -- Name
            if ESP.Names then
                ui.name.Text = plr.Name
                ui.name.Color = color
                ui.name.Position = Vector2.new(rootPos.X, rootPos.Y - topOff - 16)
                ui.name.Visible = true
            else
                ui.name.Visible = false
            end

            -- Distance
            if ESP.Distance then
                ui.dist.Text = math.floor(dist) .. "s"
                ui.dist.Position = Vector2.new(rootPos.X, rootPos.Y + botOff + 4)
                ui.dist.Visible = true
            else
                ui.dist.Visible = false
            end

            -- Tracer
            if ESP.Tracers then
                local origin
                if ESP.TracerFollowMouse then
                    origin = Vector2.new(mouse.X, mouse.Y - inset.Y)
                elseif ESP.TracerOrigin == "Middle" then
                    origin = viewport * 0.5
                else
                    origin = Vector2.new(viewport.X * 0.5, viewport.Y)
                end

                local target = Vector2.new(rootPos.X, rootPos.Y + botOff)

                ui.blacktracer.From = origin
                ui.blacktracer.To = target
                ui.blacktracer.Visible = true

                ui.tracer.From = origin
                ui.tracer.To = target
                ui.tracer.Color = color
                ui.tracer.Visible = true
            else
                ui.tracer.Visible = false
                ui.blacktracer.Visible = false
            end
        end
    end)
end

local function Stop()
    if not ESP.State then return end
    ESP.State = false
    for _, conn in ipairs(ESP_Connections) do
        pcall(conn.Disconnect, conn)
    end
    ESP_Connections = {}
    if ESP_Render then
        ESP_Render:Disconnect()
        ESP_Render = nil
    end
    for plr in pairs(ESP_UI) do
        Unregister(plr)
    end
end

return {
    Start = Start,
    Stop = Stop,
    ESP = ESP,
}
