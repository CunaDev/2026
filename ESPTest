-- ESP Public - v5 (Simple & Stable)
-- Quad box, 4-corner HRP anchored, Visibility Check, Team Check
-- API: { Start(), Stop(), ESP = { ... } }

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local GuiService = game:GetService("GuiService")
local LocalPlayer = Players.LocalPlayer
local mouse = LocalPlayer:GetMouse()
local Camera = workspace.CurrentCamera

local ESP = {
    State = false,
    Boxes = true,
    Tracers = true,
    Names = true,
    Distance = false,
    Health = true,
    TeamCheck = false,
    TeamColor = true,
    VisCheck = false,
    MaxDistance = 500,
    BoxColor = Color3.fromRGB(255, 60, 60),
    TracerColor = Color3.fromRGB(255, 60, 60),
    BoxThickness = 1,
    TracerThickness = 1,
    TracerOrigin = "Bottom",
    TracerFollowMouse = false,
    HealthBarPosition = "Left",
}

local ESP_UI = {}
local ESP_Data = {}
local ESP_Connections = {}
local ESP_Render

-- Ignore list for raycast
local IgnoreList = {}

local function IgnoreRefresh()
    IgnoreList = { LocalPlayer.Character, Camera }
    if mouse.TargetFilter then
        table.insert(IgnoreList, mouse.TargetFilter)
    end
end

local function IsVisible(origin, target, char)
    if not char then return true end
    local dir = (target - origin).unit
    local dist = (target - origin).Magnitude
    local hit = workspace:FindPartOnRayWithIgnoreList(
        Ray.new(origin, dir * dist), IgnoreList)
    if hit and not hit:IsDescendantOf(char) then
        return false
    end
    return true
end

local function NewQuad(color)
    local q = Drawing.new("Quad")
    q.Visible = false
    q.PointA = Vector2.new(0, 0)
    q.PointB = Vector2.new(0, 0)
    q.PointC = Vector2.new(0, 0)
    q.PointD = Vector2.new(0, 0)
    q.Color = color
    q.Filled = false
    q.Thickness = 1
    q.Transparency = 1
    return q
end

local function NewLine(color)
    local l = Drawing.new("Line")
    l.Visible = false
    l.From = Vector2.new(0, 0)
    l.To = Vector2.new(0, 0)
    l.Color = color
    l.Thickness = 1
    l.Transparency = 1
    return l
end

local function NewText(color, size)
    local t = Drawing.new("Text")
    t.Visible = false
    t.Center = true
    t.Outline = true
    t.Size = size
    t.Color = color
    t.Transparency = 1
    return t
end

local function MakeUI()
    return {
        box = NewQuad(Color3.fromRGB(255, 255, 255)),
        boxOutline = NewQuad(Color3.fromRGB(20, 20, 20)),
        tracer = NewLine(Color3.fromRGB(255, 255, 255)),
        tracerOutline = NewLine(Color3.fromRGB(20, 20, 20)),
        healthBg = NewLine(Color3.fromRGB(30, 30, 30)),
        healthFill = NewLine(Color3.fromRGB(0, 255, 0)),
        name = NewText(Color3.fromRGB(255, 255, 255), 13),
        dist = NewText(Color3.fromRGB(200, 200, 200), 12),
    }
end

local function GetColor(plr)
    if ESP.TeamColor then
        return plr.TeamColor.Color
    end
    return ESP.BoxColor
end

local function Register(plr)
    if plr == LocalPlayer then return end
    ESP_UI[plr] = MakeUI()
end

local function Unregister(plr)
    local ui = ESP_UI[plr]
    if ui then
        for _, d in pairs(ui) do
            pcall(d.Remove, d)
        end
        ESP_UI[plr] = nil
    end
    ESP_Data[plr] = nil
end

local function Start()
    if ESP.State then return end
    ESP.State = true
    IgnoreRefresh()

    for _, plr in ipairs(Players:GetPlayers()) do
        Register(plr)
    end

    table.insert(ESP_Connections, Players.PlayerAdded:Connect(Register))
    table.insert(ESP_Connections, Players.PlayerRemoving:Connect(Unregister))

    ESP_Render = RunService.RenderStepped:Connect(function()
        if Camera.Parent ~= workspace then
            Camera = workspace.CurrentCamera
        end
        local viewport = Camera.ViewportSize
        local inset = GuiService:GetGuiInset()
        local camPos = Camera.CFrame.Position

        for plr, ui in pairs(ESP_UI) do
            -- TeamCheck: hide same team
            if ESP.TeamCheck and plr.TeamColor == LocalPlayer.TeamColor then
                for _, d in pairs(ui) do d.Visible = false end
                continue
            end

            local char = plr.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not char or not hum or hum.Health <= 0 then
                for _, d in pairs(ui) do d.Visible = false end
                continue
            end

            local root = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
            local head = char:FindFirstChild("Head")
            if not root or not head then
                for _, d in pairs(ui) do d.Visible = false end
                continue
            end

            local dist = (root.Position - camPos).Magnitude
            if dist > ESP.MaxDistance then
                for _, d in pairs(ui) do d.Visible = false end
                continue
            end

            -- Visibility check
            if ESP.VisCheck then
                local visible = IsVisible(camPos, head.Position, char)
                if not visible then
                    for _, d in pairs(ui) do d.Visible = false end
                    continue
                end
            end

            local color = GetColor(plr)
            local cf = root.CFrame
            local scale = head.Size.Y
            local sx = 0.9 * scale
            local sy = 2.0 * scale

            -- 4 corners projected from HRP CFrame
            local TL, TLOn = Camera:WorldToViewportPoint((cf * CFrame.new(-sx, sy, 0)).Position)
            local TR, TROn = Camera:WorldToViewportPoint((cf * CFrame.new(sx, sy, 0)).Position)
            local BR, BROn = Camera:WorldToViewportPoint((cf * CFrame.new(sx, -sy, 0)).Position)
            local BL, BLOn = Camera:WorldToViewportPoint((cf * CFrame.new(-sx, -sy, 0)).Position)

            local inFront = TLOn and TROn and BROn and BLOn and TL.Z > 0

            -- Box
            if ESP.Boxes and inFront then
                ui.boxOutline.PointA = Vector2.new(TL.X - 1, TL.Y + 1)
                ui.boxOutline.PointB = Vector2.new(TR.X + 1, TR.Y + 1)
                ui.boxOutline.PointC = Vector2.new(BR.X + 1, BR.Y - 1)
                ui.boxOutline.PointD = Vector2.new(BL.X - 1, BL.Y - 1)
                ui.boxOutline.Color = Color3.fromRGB(20, 20, 20)
                ui.boxOutline.Thickness = ESP.BoxThickness + 2
                ui.boxOutline.Visible = true

                ui.box.PointA = TL
                ui.box.PointB = TR
                ui.box.PointC = BR
                ui.box.PointD = BL
                ui.box.Color = color
                ui.box.Thickness = ESP.BoxThickness
                ui.box.Visible = true
            else
                ui.box.Visible = false
                ui.boxOutline.Visible = false
            end

            -- Health bar
            if ESP.Health and inFront then
                local hpRatio = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                local hpColor = Color3.fromRGB(0, 255, 0):Lerp(Color3.fromRGB(255, 0, 0), 1 - hpRatio)
                local gap = 5

                if ESP.HealthBarPosition == "Left" then
                    local bx = BL.X - gap
                    ui.healthBg.From = Vector2.new(bx, BL.Y)
                    ui.healthBg.To = Vector2.new(bx, TL.Y)
                    ui.healthFill.From = Vector2.new(bx, BL.Y)
                    ui.healthFill.To = Vector2.new(bx, BL.Y - (BL.Y - TL.Y) * hpRatio)
                elseif ESP.HealthBarPosition == "Right" then
                    local bx = BR.X + gap
                    ui.healthBg.From = Vector2.new(bx, BR.Y)
                    ui.healthBg.To = Vector2.new(bx, TR.Y)
                    ui.healthFill.From = Vector2.new(bx, BR.Y)
                    ui.healthFill.To = Vector2.new(bx, BR.Y - (BR.Y - TR.Y) * hpRatio)
                elseif ESP.HealthBarPosition == "Top" then
                    local by = TL.Y - gap
                    ui.healthBg.From = Vector2.new(TL.X, by)
                    ui.healthBg.To = Vector2.new(TR.X, by)
                    ui.healthFill.From = Vector2.new(TL.X, by)
                    ui.healthFill.To = Vector2.new(TL.X + (TR.X - TL.X) * hpRatio, by)
                else -- Bottom
                    local by = BL.Y + gap
                    ui.healthBg.From = Vector2.new(BL.X, by)
                    ui.healthBg.To = Vector2.new(BR.X, by)
                    ui.healthFill.From = Vector2.new(BL.X, by)
                    ui.healthFill.To = Vector2.new(BL.X + (BR.X - BL.X) * hpRatio, by)
                end

                ui.healthBg.Color = Color3.fromRGB(30, 30, 30)
                ui.healthBg.Thickness = 3
                ui.healthBg.Visible = true
                ui.healthFill.Color = hpColor
                ui.healthFill.Thickness = 2
                ui.healthFill.Visible = true
            else
                ui.healthBg.Visible = false
                ui.healthFill.Visible = false
            end

            -- Name
            if ESP.Names and inFront then
                local nY = (TL.Y + TR.Y) / 2 - sy * 0.4
                ui.name.Text = plr.Name
                ui.name.Position = Vector2.new((TL.X + TR.X) / 2, nY)
                ui.name.Color = color
                ui.name.Visible = true
            else
                ui.name.Visible = false
            end

            -- Distance
            if ESP.Distance and inFront then
                local dY = (BL.Y + BR.Y) / 2 + 4
                ui.dist.Text = math.floor(dist) .. "s"
                ui.dist.Position = Vector2.new((BL.X + BR.X) / 2, dY)
                ui.dist.Visible = true
            else
                ui.dist.Visible = false
            end

            -- Tracer
            if ESP.Tracers then
                local origin
                if ESP.TracerFollowMouse or ESP.TracerOrigin == "Mouse" then
                    origin = Vector2.new(mouse.X, mouse.Y - inset.Y)
                elseif ESP.TracerOrigin == "Middle" then
                    origin = Vector2.new(viewport.X / 2, viewport.Y / 2)
                else
                    origin = Vector2.new(viewport.X / 2, viewport.Y)
                end

                local target = Vector2.new((BL.X + BR.X) / 2, (BL.Y + BR.Y) / 2)

                ui.tracerOutline.From = origin
                ui.tracerOutline.To = target
                ui.tracerOutline.Thickness = ESP.TracerThickness + 2
                ui.tracerOutline.Visible = true

                ui.tracer.From = origin
                ui.tracer.To = target
                ui.tracer.Thickness = ESP.TracerThickness
                ui.tracer.Color = color
                ui.tracer.Visible = true
            else
                ui.tracer.Visible = false
                ui.tracerOutline.Visible = false
            end
        end
    end)
end

local function Stop()
    if not ESP.State then return end
    ESP.State = false
    if ESP_Render then
        ESP_Render:Disconnect()
        ESP_Render = nil
    end
    for _, conn in ipairs(ESP_Connections) do
        pcall(conn.Disconnect, conn)
    end
    ESP_Connections = {}
    for plr in pairs(ESP_UI) do
        Unregister(plr)
    end
end

return {
    Start = Start,
    Stop = Stop,
    ESP = ESP,
}
