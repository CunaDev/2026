-- Improved ESP Module - Public Edition
-- Fixed: stable bounding box, no more box tearing
-- API: { Start(), Stop(), ESP = { Boxes, Health, Names, Tracers, TeamCheck, MaxDistance, etc. } }

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local ESP = {
    State = false,
    Boxes = true,
    Health = true,
    Names = true,
    Distance = false,
    Tracers = true,
    TeamCheck = true,
    TeamColor = true,
    MaxDistance = 500,
    BoxColor = Color3.fromRGB(255, 60, 60),
    TracerColor = Color3.fromRGB(255, 60, 60),
    TracerThickness = 1,
    BoxThickness = 1,
    TracerOrigin = "Bottom", -- "Bottom", "Middle" or "Mouse"
}

local ESP_Data = {}
local ESP_UI = {}
local ESP_Connections = {}
local ESP_Render
local mouse = LocalPlayer:GetMouse()
local camera = workspace.CurrentCamera

local function MakeUI()
    return {
        box = Drawing.new("Square"),
        boxOutline = Drawing.new("Square"),
        name = Drawing.new("Text"),
        dist = Drawing.new("Text"),
        healthBg = Drawing.new("Square"),
        healthBar = Drawing.new("Square"),
        tracer = Drawing.new("Line"),
        tracerOutline = Drawing.new("Line"),
    }
end

local function InitDraw(d)
    d.Visible = false
    d.Thickness = 1
end

local function SetupUI(ui)
    InitDraw(ui.box)
    ui.box.Filled = false
    ui.box.Color = ESP.BoxColor

    InitDraw(ui.boxOutline)
    ui.boxOutline.Filled = false
    ui.boxOutline.Color = Color3.fromRGB(0, 0, 0)
    ui.boxOutline.Thickness = ESP.BoxThickness * 2

    InitDraw(ui.tracer)
    ui.tracer.Color = ESP.TracerColor

    InitDraw(ui.tracerOutline)
    ui.tracerOutline.Color = Color3.fromRGB(0, 0, 0)
    ui.tracerOutline.Thickness = ESP.TracerThickness * 2

    InitDraw(ui.healthBg)
    ui.healthBg.Filled = true
    ui.healthBg.Color = Color3.fromRGB(30, 30, 30)

    InitDraw(ui.healthBar)
    ui.healthBar.Filled = true

    ui.name.Center = true
    ui.name.Outline = true
    ui.name.Size = 13
    ui.name.Color = Color3.fromRGB(255, 255, 255)

    ui.dist.Center = true
    ui.dist.Outline = true
    ui.dist.Size = 12
    ui.dist.Color = Color3.fromRGB(200, 200, 200)
end

local function GetBoundingBox2D(character)
    -- Get all visible parts, project their corners to screen, return min/max X,Y
    local minX, maxX = math.huge, -math.huge
    local minY, maxY = math.huge, -math.huge
    local anyOnScreen = false

    -- Use GetBoundingBox for stable CFrame + Size
    local success, cframe, size = pcall(function()
        return character:GetBoundingBox()
    end)

    if success and cframe and size then
        local sx, sy, sz = size.X / 2, size.Y / 2, size.Z / 2
        local corners = {
            Vector3.new(-sx, -sy, -sz), Vector3.new(sx, -sy, -sz),
            Vector3.new(-sx, sy, -sz),  Vector3.new(sx, sy, -sz),
            Vector3.new(-sx, -sy, sz),  Vector3.new(sx, -sy, sz),
            Vector3.new(-sx, sy, sz),   Vector3.new(sx, sy, sz),
        }
        for _, offset in ipairs(corners) do
            local worldPos = cframe * offset
            local screenPos, onScreen = camera:WorldToViewportPoint(worldPos)
            if onScreen then
                anyOnScreen = true
                if screenPos.X < minX then minX = screenPos.X end
                if screenPos.X > maxX then maxX = screenPos.X end
                if screenPos.Y < minY then minY = screenPos.Y end
                if screenPos.Y > maxY then maxY = screenPos.Y end
            end
        end
    end

    if not anyOnScreen then
        return nil
    end

    -- Add padding so box doesn't clip
    local pad = 2
    return {
        X = minX - pad,
        Y = minY - pad,
        Width = maxX - minX + pad * 2,
        Height = maxY - minY + pad * 2,
    }
end

local function GetColor(character)
    local plr = Players:GetPlayerFromCharacter(character)
    if not plr then
        return Color3.fromRGB(255, 170, 0) -- NPC
    end
    if ESP.TeamCheck and plr.TeamColor ~= LocalPlayer.TeamColor then
        return Color3.fromRGB(255, 60, 60)
    end
    if ESP.TeamColor then
        return plr.TeamColor.Color
    end
    return ESP.BoxColor
end

local function Register(plr)
    if plr == LocalPlayer then return end
    local ui = MakeUI()
    SetupUI(ui)
    ESP_UI[plr] = ui
end

local function Unregister(plr)
    local ui = ESP_UI[plr]
    if ui then
        for _, d in pairs(ui) do
            pcall(d.Remove, d)
        end
        ESP_UI[plr] = nil
    end
end

local function Start()
    if ESP.State then return end
    ESP.State = true

    for _, plr in ipairs(Players:GetPlayers()) do
        Register(plr)
    end

    table.insert(ESP_Connections, Players.PlayerAdded:Connect(Register))
    table.insert(ESP_Connections, Players.PlayerRemoving:Connect(Unregister))

    ESP_Render = RunService.RenderStepped:Connect(function()
        camera = workspace.CurrentCamera
        if not camera then return end
        local viewport = camera.ViewportSize

        for plr, ui in pairs(ESP_UI) do
            local char = plr.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not char or not hum or hum.Health <= 0 then
                for _, d in pairs(ui) do d.Visible = false end
                continue
            end

            local root = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
            if not root then
                for _, d in pairs(ui) do d.Visible = false end
                continue
            end

            local rootPos, rootOnScreen = camera:WorldToViewportPoint(root.Position)
            local dist = (root.Position - camera.CFrame.Position).Magnitude
            if not rootOnScreen or dist > ESP.MaxDistance then
                for _, d in pairs(ui) do d.Visible = false end
                continue
            end

            -- Get stable 2D bounding box
            local bb = GetBoundingBox2D(char)
            if not bb then
                -- Fallback: use root position with distance-based size
                local h = math.clamp(1000 / dist * 80, 30, 320)
                local w = h * 0.6
                bb = {
                    X = rootPos.X - w / 2,
                    Y = rootPos.Y - h / 2,
                    Width = w,
                    Height = h,
                }
            end

            -- 폭이 과하게 넓어지는 것 방지 (팔 벌림 등): 높이 기반으로 폭 제한
            bb.Width = math.min(bb.Width, bb.Height * 0.65)

            local color = GetColor(char)
            local boxThick = ESP.BoxThickness
            local tracerThick = ESP.TracerThickness

            -- Box (with outline)
            if ESP.Boxes then
                ui.boxOutline.Position = Vector2.new(bb.X - 1, bb.Y - 1)
                ui.boxOutline.Size = Vector2.new(bb.Width + 2, bb.Height + 2)
                ui.boxOutline.Thickness = boxThick + 2
                ui.boxOutline.Color = Color3.fromRGB(0, 0, 0)
                ui.boxOutline.Visible = true

                ui.box.Position = Vector2.new(bb.X, bb.Y)
                ui.box.Size = Vector2.new(bb.Width, bb.Height)
                ui.box.Thickness = boxThick
                ui.box.Color = color
                ui.box.Visible = true
            else
                ui.box.Visible = false
                ui.boxOutline.Visible = false
            end

            -- Health bar
            if ESP.Health then
                local maxhp = hum.MaxHealth
                local hpRatio = maxhp > 0 and math.clamp(hum.Health / maxhp, 0, 1) or 0
                local barWidth = bb.Width
                local barHeight = 4

                ui.healthBg.Position = Vector2.new(bb.X, bb.Y - barHeight - 2)
                ui.healthBg.Size = Vector2.new(barWidth, barHeight)
                ui.healthBg.Visible = true

                ui.healthBar.Position = Vector2.new(bb.X, bb.Y - barHeight - 2)
                ui.healthBar.Size = Vector2.new(barWidth * hpRatio, barHeight)
                ui.healthBar.Color = hpRatio > 0.5 and Color3.fromRGB(0, 240, 0)
                    or (hpRatio > 0.25 and Color3.fromRGB(255, 200, 0) or Color3.fromRGB(255, 40, 40))
                ui.healthBar.Visible = true
            else
                ui.healthBg.Visible = false
                ui.healthBar.Visible = false
            end

            -- Name
            if ESP.Names then
                ui.name.Text = plr.Name
                ui.name.Position = Vector2.new(rootPos.X, bb.Y - 18)
                ui.name.Visible = true
            else
                ui.name.Visible = false
            end

            -- Distance
            if ESP.Distance then
                ui.dist.Text = math.floor(dist) .. "s"
                ui.dist.Position = Vector2.new(rootPos.X, bb.Y + bb.Height + 4)
                ui.dist.Visible = true
            else
                ui.dist.Visible = false
            end

            -- Tracer (with outline)
            if ESP.Tracers then
                local origin
                if ESP.TracerOrigin == "Mouse" then
                    origin = Vector2.new(mouse.X, mouse.Y)
                elseif ESP.TracerOrigin == "Middle" then
                    origin = viewport * 0.5
                else -- Bottom
                    origin = Vector2.new(viewport.X * 0.5, viewport.Y)
                end

                local target = Vector2.new(rootPos.X, bb.Y + bb.Height)

                ui.tracerOutline.From = origin
                ui.tracerOutline.To = target
                ui.tracerOutline.Thickness = tracerThick + 2
                ui.tracerOutline.Color = Color3.fromRGB(0, 0, 0)
                ui.tracerOutline.Visible = true

                ui.tracer.From = origin
                ui.tracer.To = target
                ui.tracer.Thickness = tracerThick
                ui.tracer.Color = color
                ui.tracer.Visible = true
            else
                ui.tracer.Visible = false
                ui.tracerOutline.Visible = false
            end
        end
    end)
end

local function Stop()
    if not ESP.State then return end
    ESP.State = false
    for _, conn in ipairs(ESP_Connections) do
        pcall(conn.Disconnect, conn)
    end
    ESP_Connections = {}
    if ESP_Render then
        ESP_Render:Disconnect()
        ESP_Render = nil
    end
    for plr in pairs(ESP_UI) do
        Unregister(plr)
    end
end

return {
    Start = Start,
    Stop = Stop,
    ESP = ESP,
}
