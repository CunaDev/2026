-- ESP Module - Blissful Design (fix: sizing, drift, team check, health pos)
-- Quad box, vertical health bar, modular API
-- API: { Start(), Stop(), ESP = { ... } }

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local GuiService = game:GetService("GuiService")
local LocalPlayer = Players.LocalPlayer
local mouse = LocalPlayer:GetMouse()

local ESP = {
    State = false,
    Boxes = true,
    Tracers = true,
    Names = true,
    Distance = false,
    Health = true,
    TeamCheck = false,  -- true = hide same-team players
    TeamColor = true,    -- color by team
    MaxDistance = 500,
    BoxColor = Color3.fromRGB(255, 0, 0),
    TracerColor = Color3.fromRGB(255, 0, 0),
    BoxThickness = 1,
    TracerThickness = 1,
    TracerOrigin = "Bottom",
    TracerFollowMouse = false,
    HealthBarPosition = "Left", -- "Left", "Right", "Top", "Bottom"
}

local ESP_UI = {}
local ESP_Connections = {}
local ESP_Render

local function NewQuad(thickness, color)
    local q = Drawing.new("Quad")
    q.Visible = false
    q.PointA = Vector2.new(0, 0)
    q.PointB = Vector2.new(0, 0)
    q.PointC = Vector2.new(0, 0)
    q.PointD = Vector2.new(0, 0)
    q.Color = color
    q.Filled = false
    q.Thickness = thickness
    q.Transparency = 1
    return q
end

local function NewLine(thickness, color)
    local l = Drawing.new("Line")
    l.Visible = false
    l.From = Vector2.new(0, 0)
    l.To = Vector2.new(0, 0)
    l.Color = color
    l.Thickness = thickness
    l.Transparency = 1
    return l
end

local function MakeUI()
    return {
        blacktracer = NewLine(2, Color3.fromRGB(0, 0, 0)),
        tracer = NewLine(1, ESP.TracerColor),
        black = NewQuad(2, Color3.fromRGB(0, 0, 0)),
        box = NewQuad(1, ESP.BoxColor),
        healthbar = NewLine(3, Color3.fromRGB(0, 0, 0)),
        greenhealth = NewLine(1.5, Color3.fromRGB(0, 0, 0)),
        name = Drawing.new("Text"),
        dist = Drawing.new("Text"),
    }
end

local function SetupUI(ui)
    ui.name.Center = true
    ui.name.Outline = true
    ui.name.Size = 13
    ui.name.Visible = false
    ui.dist.Center = true
    ui.dist.Outline = true
    ui.dist.Size = 12
    ui.dist.Visible = false
end

local function Colorize(lib, color)
    for _, x in pairs(lib) do
        if x ~= lib.healthbar and x ~= lib.greenhealth and x ~= lib.blacktracer and x ~= lib.black then
            x.Color = color
        end
    end
end

local function BoxSizeImpl(ui, cx, cy, hw, hh)
    ui.black.PointA = Vector2.new(cx + hw + 1, cy - hh - 1)
    ui.black.PointB = Vector2.new(cx - hw - 1, cy - hh - 1)
    ui.black.PointC = Vector2.new(cx - hw - 1, cy + hh + 1)
    ui.black.PointD = Vector2.new(cx + hw + 1, cy + hh + 1)

    ui.box.PointA = Vector2.new(cx + hw, cy - hh)
    ui.box.PointB = Vector2.new(cx - hw, cy - hh)
    ui.box.PointC = Vector2.new(cx - hw, cy + hh)
    ui.box.PointD = Vector2.new(cx + hw, cy + hh)
end

local function GetColor(plr)
    if ESP.TeamColor then
        return plr.TeamColor.Color
    end
    return ESP.BoxColor
end

local function Register(plr)
    if plr == LocalPlayer then return end
    local ui = MakeUI()
    SetupUI(ui)
    ESP_UI[plr] = ui
end

local function Unregister(plr)
    local ui = ESP_UI[plr]
    if ui then
        for _, d in pairs(ui) do
            pcall(d.Remove, d)
        end
        ESP_UI[plr] = nil
    end
end

local function Start()
    if ESP.State then return end
    ESP.State = true

    for _, plr in ipairs(Players:GetPlayers()) do
        Register(plr)
    end

    table.insert(ESP_Connections, Players.PlayerAdded:Connect(Register))
    table.insert(ESP_Connections, Players.PlayerRemoving:Connect(Unregister))

    ESP_Render = RunService.RenderStepped:Connect(function()
        local camera = workspace.CurrentCamera
        if not camera then return end
        local viewport = camera.ViewportSize
        local inset = GuiService:GetGuiInset()

        for plr, ui in pairs(ESP_UI) do
            -- Team Check: hide ESP for same team
            if ESP.TeamCheck and plr.TeamColor == LocalPlayer.TeamColor then
                for _, d in pairs(ui) do d.Visible = false end
                continue
            end

            local char = plr.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not char or not hum or hum.Health <= 0 then
                for _, d in pairs(ui) do d.Visible = false end
                continue
            end

            local head = char:FindFirstChild("Head")
            local root = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
            if not head or not root then
                for _, d in pairs(ui) do d.Visible = false end
                continue
            end

            local dist = (root.Position - camera.CFrame.Position).Magnitude
            if dist > ESP.MaxDistance then
                for _, d in pairs(ui) do d.Visible = false end
                continue
            end

            -- Screen-space approach: measure head-to-root on screen
            local headScreen = camera:WorldToViewportPoint(head.Position)
            local rootScreen = camera:WorldToViewportPoint(root.Position)
            local distY = math.clamp(math.abs(headScreen.Y - rootScreen.Y), 2, math.huge)

            -- Box center between head and root
            local boxCX = rootScreen.X
            local boxCY = (headScreen.Y + rootScreen.Y) / 2
            local boxHalfH = distY * 1.35
            local boxHalfW = boxHalfH * 0.5

            -- At distance, minimum visible box (centered on head/root midpoint)
            local minH = 25
            if boxHalfH < minH then
                boxHalfH = minH
                boxHalfW = minH * 0.5
            end

            local color = GetColor(plr)
            local boxThick = ESP.BoxThickness
            local tracerThick = ESP.TracerThickness

            ui.black.Thickness = boxThick + 2
            ui.box.Thickness = boxThick
            ui.blacktracer.Thickness = tracerThick + 2
            ui.tracer.Thickness = tracerThick

            -- Box
            if ESP.Boxes then
                BoxSizeImpl(ui, boxCX, boxCY, boxHalfW, boxHalfH)
                ui.box.Color = color
                ui.black.Visible = true
                ui.box.Visible = true
            else
                ui.black.Visible = false
                ui.box.Visible = false
            end

            -- Health bar
            if ESP.Health then
                local hpRatio = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                local hpColor = Color3.fromRGB(0, 255, 0):Lerp(
                    Color3.fromRGB(255, 0, 0), 1 - hpRatio)
                local gap = 4
                local hpLen = boxHalfH * 2

                if ESP.HealthBarPosition == "Left" then
                    local bx = boxCX - boxHalfW - gap
                    ui.healthbar.From = Vector2.new(bx, boxCY + boxHalfH)
                    ui.healthbar.To = Vector2.new(bx, boxCY - boxHalfH)
                    ui.greenhealth.From = Vector2.new(bx, boxCY + boxHalfH)
                    ui.greenhealth.To = Vector2.new(bx, boxCY + boxHalfH - hpLen * hpRatio)
                elseif ESP.HealthBarPosition == "Right" then
                    local bx = boxCX + boxHalfW + gap
                    ui.healthbar.From = Vector2.new(bx, boxCY + boxHalfH)
                    ui.healthbar.To = Vector2.new(bx, boxCY - boxHalfH)
                    ui.greenhealth.From = Vector2.new(bx, boxCY + boxHalfH)
                    ui.greenhealth.To = Vector2.new(bx, boxCY + boxHalfH - hpLen * hpRatio)
                elseif ESP.HealthBarPosition == "Top" then
                    local by = boxCY - boxHalfH - gap
                    local hpW = boxHalfW * 2
                    ui.healthbar.From = Vector2.new(boxCX - boxHalfW, by)
                    ui.healthbar.To = Vector2.new(boxCX + boxHalfW, by)
                    ui.greenhealth.From = Vector2.new(boxCX - boxHalfW, by)
                    ui.greenhealth.To = Vector2.new(boxCX - boxHalfW + hpW * hpRatio, by)
                else -- Bottom
                    local by = boxCY + boxHalfH + gap
                    local hpW = boxHalfW * 2
                    ui.healthbar.From = Vector2.new(boxCX - boxHalfW, by)
                    ui.healthbar.To = Vector2.new(boxCX + boxHalfW, by)
                    ui.greenhealth.From = Vector2.new(boxCX - boxHalfW, by)
                    ui.greenhealth.To = Vector2.new(boxCX - boxHalfW + hpW * hpRatio, by)
                end

                ui.greenhealth.Color = hpColor
                ui.healthbar.Color = Color3.fromRGB(0, 0, 0)
                ui.healthbar.Visible = true
                ui.greenhealth.Visible = true
            else
                ui.healthbar.Visible = false
                ui.greenhealth.Visible = false
            end

            -- Name
            if ESP.Names then
                ui.name.Text = plr.Name
                ui.name.Color = color
                ui.name.Position = Vector2.new(boxCX, boxCY - boxHalfH - 16)
                ui.name.Visible = true
            else
                ui.name.Visible = false
            end

            -- Distance
            if ESP.Distance then
                ui.dist.Text = math.floor(dist) .. "s"
                ui.dist.Position = Vector2.new(boxCX, boxCY + boxHalfH + 4)
                ui.dist.Visible = true
            else
                ui.dist.Visible = false
            end

            -- Tracer
            if ESP.Tracers then
                local origin
                if ESP.TracerFollowMouse then
                    origin = Vector2.new(mouse.X, mouse.Y - inset.Y)
                elseif ESP.TracerOrigin == "Middle" then
                    origin = Vector2.new(viewport.X / 2, viewport.Y / 2)
                else
                    origin = Vector2.new(viewport.X / 2, viewport.Y)
                end

                local target = Vector2.new(boxCX, boxCY + boxHalfH)

                ui.blacktracer.From = origin
                ui.blacktracer.To = target
                ui.blacktracer.Visible = true

                ui.tracer.From = origin
                ui.tracer.To = target
                ui.tracer.Color = color
                ui.tracer.Visible = true
            else
                ui.tracer.Visible = false
                ui.blacktracer.Visible = false
            end
        end
    end)
end

local function Stop()
    if not ESP.State then return end
    ESP.State = false
    for _, conn in ipairs(ESP_Connections) do
        pcall(conn.Disconnect, conn)
    end
    ESP_Connections = {}
    if ESP_Render then
        ESP_Render:Disconnect()
        ESP_Render = nil
    end
    for plr in pairs(ESP_UI) do
        Unregister(plr)
    end
end

return {
    Start = Start,
    Stop = Stop,
    ESP = ESP,
}
